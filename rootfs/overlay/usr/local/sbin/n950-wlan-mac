#!/bin/sh
# Print a stable, locally administered MAC address for the N950's wl1271,
# derived from the eMMC's CID: the same on every boot, different between
# phones. With an interface name, set it there (from 10-n950-wlan.rules,
# while the interface is still down).
PATH=/usr/sbin:/usr/bin:/sbin:/bin
cid=
for d in /sys/class/mmc_host/mmc*/mmc*:*; do
	[ "$(cat "$d/type" 2>/dev/null)" = MMC ] || continue
	cid=$(cat "$d/cid" 2>/dev/null) && break
done
[ -n "$cid" ] || cid=$(cat /etc/machine-id 2>/dev/null)
h=$(printf '%s' "$cid" | md5sum | cut -c1-10)
mac=$(printf '02:%s:%s:%s:%s:%s' $(echo "$h" | sed 's/../& /g'))
if [ -n "$1" ]; then
	ip link set dev "$1" address "$mac"
else
	echo "$mac"
fi
