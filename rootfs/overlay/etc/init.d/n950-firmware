#!/sbin/openrc-run
# The N950's own calibration and firmware files come from its Harmattan
# partition (2), never from this image: the Wi-Fi's NVS (calibrated for this
# board, not the generic one of firmware-ti-connectivity) and the Bluetooth
# firmware that hci_nokia loads. Copied once, on the first boot; delete the
# copies to fetch them again.

description="Copy the N950's Wi-Fi and Bluetooth files from Harmattan"

HARMATTAN=/dev/mmcblk1p2
MNT=/run/n950-harmattan
NVS=/lib/firmware/ti-connectivity/wl1271-nvs.bin

depend() {
	after checkroot.sh mountall.sh
	before networking icd2
}

copy() {
	# copy <file in Harmattan> <destination>
	[ -e "$2" ] && return 0
	[ -f "$MNT/$1" ] || { ewarn "Harmattan has no $1"; return 1; }
	mkdir -p "$(dirname "$2")" && cp "$MNT/$1" "$2"
}

start() {
	[ -e "$NVS" ] && [ -e /lib/firmware/nokia/ti1273.bin ] && return 0
	ebegin "Copying the Wi-Fi and Bluetooth files from Harmattan"
	mkdir -p "$MNT"
	if ! mount -o ro "$HARMATTAN" "$MNT"; then
		eend 1 "cannot mount $HARMATTAN"
		return 0
	fi
	copy lib/firmware/wl1271-nvs.bin "$NVS"
	copy lib/firmware/ti1273.bin /lib/firmware/nokia/ti1273.bin
	umount "$MNT"
	rmdir "$MNT"
	# Without Harmattan's NVS the generic one has to do
	[ -e "$NVS" ] || cp "$NVS.distrib" "$NVS" 2>/dev/null
	# wlcore read the NVS (or found none) when it probed: probe again
	if lsmod | grep -q '^wl12xx'; then
		modprobe -r wl12xx && modprobe wl12xx
	fi
	eend 0
}
