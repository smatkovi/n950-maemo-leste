#!/bin/sh
# Compressed swap in RAM, as Harmattan does it: its enable-swap.conf sets up
# 256 MB of ramzswap without a backing device on phones with more than 1 GB
# (the N950 and the N9 both just above). zram is ramzswap's successor here,
# lzo-rle the kernel's default. OneNAND's mtd4 as flash-backed swap would need
# CONFIG_MTD_SWAP for wear levelling; raw mtdblock would wear the flash out.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
grep -q '^/dev/zram0 ' /proc/swaps && exit 0
modprobe zram num_devices=1 2>/dev/null || exit 0
[ -w /sys/block/zram0/disksize ] || exit 0
echo 256M > /sys/block/zram0/disksize 2>/dev/null || exit 0
mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0
exit 0
