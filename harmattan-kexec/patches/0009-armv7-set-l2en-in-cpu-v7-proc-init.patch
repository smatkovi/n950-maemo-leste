From 8ac86780cc57e125c57f2f7200dc89ed5f3f4e2b Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 24 Nov 2026 17:44:56 +0100
Subject: [PATCH] ARMv7: set ACTLR.L2EN in cpu_v7_proc_init (L2 off after
 kexec)

ubiboot's 2.6.32 kernel clears L2EN in cpu_v7_proc_fin before it kexecs
the Harmattan kernel, and the PR1.3 kernel relies on NOLO having set it,
so a MeeGo booted from ubiboot on the N950 ran with the L2 cache off
(pointer chase 48-256 KB: 113-375 ns vs 8-33 ns on the N9).  Take the L2
hunk of UbiBoot's openmode_l2fix.patch, without its Aegis changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/mm/proc-v7.S | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm/mm/proc-v7.S b/arch/arm/mm/proc-v7.S
index 7aaf88a3..a441c12c 100644
--- a/arch/arm/mm/proc-v7.S
+++ b/arch/arm/mm/proc-v7.S
@@ -41,6 +41,12 @@
 #endif
 
 ENTRY(cpu_v7_proc_init)
+	@ ubiboot's kernel clears ACTLR.L2EN in cpu_v7_proc_fin before kexec and
+	@ nothing sets it again, so a kexec'd Harmattan ran without L2 (N950).
+	@ Same three lines as UbiBoot's openmode_l2fix.patch (L2 part only).
+	mrc	p15, 0, r0, c1, c0, 1		@ aux ctrl register
+	orr	r0, r0, #0x2			@ L2EN
+	mcr	p15, 0, r0, c1, c0, 1		@ enable L2 cache
 	mov	pc, lr
 ENDPROC(cpu_v7_proc_init)
 
-- 
2.56.0

