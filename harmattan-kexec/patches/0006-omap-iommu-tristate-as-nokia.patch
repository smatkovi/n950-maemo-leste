From d43f5840ecc3863daa9e6031c98c68fbae72aa7e Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 9 Nov 2026 07:59:11 +0100
Subject: [PATCH] omap: iommu: tristate again, as in Nokia's tree
 (rm581_defconfig has OMAP_IOMMU=m, the stock iommu/iovmm/iommu2/omap3-iommu
 are modules)

---
 arch/arm/plat-omap/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/plat-omap/Kconfig b/arch/arm/plat-omap/Kconfig
index adce0c6f..2cf085ce 100644
--- a/arch/arm/plat-omap/Kconfig
+++ b/arch/arm/plat-omap/Kconfig
@@ -177,7 +177,7 @@ config OMAP_MBOX_KFIFO_SIZE
 	  module parameter).
 
 config OMAP_IOMMU
-	bool
+	tristate
 
 config OMAP_IOMMU_DEBUG
 	depends on OMAP_IOMMU
-- 
2.56.0

