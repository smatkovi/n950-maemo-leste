From 50d31c5b19f170ab7dcf93d6702043b82a4551fe Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 24 Nov 2026 17:59:32 +0100
Subject: [PATCH] mmc: core: do not release the host twice in the eMMC retry

mmc_attach_mmc() releases the host on its error path. The kexec retry
released it again before re-claiming, which fired WARN_ON(!host->claimed)
in mmc_release_host() and left claim_cnt/nesting_cnt off by one, so the
host was never lazily disabled again: on the N950 the MMC2 functional
clock (mmchs_fck) stays on after boot, which keeps CORE from idling.
After a failed attach only claim the host again; after the retries are
used up go to out as the original code did.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mmc/core/core.c | 31 +++++++++++++++++++++++--------
 1 file changed, 23 insertions(+), 8 deletions(-)

diff --git a/drivers/mmc/core/core.c b/drivers/mmc/core/core.c
index b9198203..0fd220d9 100644
--- a/drivers/mmc/core/core.c
+++ b/drivers/mmc/core/core.c
@@ -1479,22 +1479,37 @@ mmc_rescan_retry:
 	 * ...and finally MMC.
 	 */
 mmc_only:
-	err = mmc_send_op_cond(host, 0, &ocr);
-	if (!err) {
-		if (!mmc_attach_mmc(host, ocr))
-			goto out;	/* attached */
-		mmc_power_off(host);
-	}
-
 	/*
 	 * n950: the Nokia N950's eMMC at times times out on its first data
 	 * transfer (the EXT_CSD read inside mmc_attach_mmc, or the CMD1
-	 * OP_COND above) after another kernel used it -- e.g. when this
+	 * OP_COND below) after another kernel used it -- e.g. when this
 	 * kernel was started by a kexec, the outgoing kernel left the card
 	 * initialised.  A non-removable card is scanned only once, so the
 	 * boot then waits for its root device for ever (black screen).  Give
 	 * it a few more tries, 200 ms apart; the next attempt finds it.
+	 *
+	 * mmc_attach_mmc() releases the host itself, on success and on
+	 * failure, so after a failed attach the host must only be claimed
+	 * again.  Releasing it a second time (as the first version of this
+	 * retry did) drove claim_cnt and nesting_cnt negative: the host was
+	 * never disabled again and its functional clock stayed on.
 	 */
+	err = mmc_send_op_cond(host, 0, &ocr);
+	if (!err) {
+		if (!mmc_attach_mmc(host, ocr))
+			goto out;	/* attached; the host is released */
+		mmc_power_off(host);	/* the host is released */
+		if ((host->caps & MMC_CAP_NONREMOVABLE) &&
+		    mmc_rescan_retries++ < 10) {
+			pr_info("%s: retrying the non-removable card (%d)\n",
+				mmc_hostname(host), mmc_rescan_retries);
+			mmc_delay(200);
+			mmc_claim_host(host);
+			goto mmc_rescan_retry;
+		}
+		goto out;
+	}
+
 	if ((host->caps & MMC_CAP_NONREMOVABLE) && mmc_rescan_retries++ < 10) {
 		pr_info("%s: retrying the non-removable card (%d)\n",
 			mmc_hostname(host), mmc_rescan_retries);
-- 
2.56.0

