From c49a8ecf0eea216068df08c4647969f471cf6b26 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 9 Nov 2026 08:01:08 +0100
Subject: [PATCH] Makefile: pass -mno-unaligned-access only if the compiler
 knows it (CodeSourcery 2009q3 / gcc 4.4 does not; Nokia's compiler never
 emitted unaligned accesses anyway)

---
 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index c7c062e1..ab851091 100644
--- a/Makefile
+++ b/Makefile
@@ -579,7 +579,7 @@ KBUILD_CFLAGS	+= $(call cc-option,-fno-dwarf2-cfi-asm)
 # conserve stack if available
 KBUILD_CFLAGS   += $(call cc-option,-fconserve-stack)
 
-KBUILD_CFLAGS	+= -mno-unaligned-access
+KBUILD_CFLAGS	+= $(call cc-option,-mno-unaligned-access)
 
 # Add user supplied CPPFLAGS, AFLAGS and CFLAGS as the last assignments
 # But warn user when we do so
-- 
2.56.0

