 	mrc	p15, 0, r9, c0, c0		@ get processor id
 	bl	__lookup_processor_type		@ r5=procinfo r9=cpuid
 	movs	r10, r5				@ invalid processor (r5=0)?
@@ -87,6 +89,7 @@ ENTRY(stext)
 	beq	__error_a			@ yes, error 'a'
 	bl	__vet_atags
 	bl	__create_page_tables
+	n950_trk_phys	8			@ n950tr stage 8: page tables built
 
 	/*
 	 * The following calls CPU specific code in a position independent
@@ -158,6 +161,7 @@ __secondary_data:
  * registers.
  */
 __enable_mmu:
+	n950_trk_phys	9			@ n950tr stage 9: cpu setup done
 #ifdef CONFIG_ALIGNMENT_TRAP
 	orr	r0, r0, #CR_A
 #else
@@ -329,8 +333,111 @@ __create_page_tables:
 	str	r3, [r0]
 #endif
 #endif
+	/*
+	 * n950tr: map the OneNAND window and the RAM trace page as
+	 * strongly-ordered sections at N950TR_ONENAND_VA / N950TR_DDR_VA so
+	 * the tracer works from __mmap_switched until paging_init() rebuilds
+	 * the same two mappings from omap34xx_io_desc[].
+	 */
+	add	r0, r4, #N950TR_ONENAND_VA >> 18
+	ldr	r3, =N950TR_ONENAND_PA | N950TR_SECT_FLAGS
+	str	r3, [r0], #4
+	ldr	r3, =N950TR_DDR_PA | N950TR_SECT_FLAGS
+	str	r3, [r0]
 	mov	pc, lr
 ENDPROC(__create_page_tables)
 	.ltorg
 
+/*
+ * n950tr - N950 boot tracer (kernel side), see n950trace.h.
+ *
+ *  r12 = stage, r6 = OneNAND window base, r7 = RAM record base (physical
+ *  before the MMU is on, virtual afterwards).  Clobbers r3, r5, r11;
+ *  r6, r7, r12 are read only.  Leaf routine, needs no stack.  Same record/page layout as
+ *  n950_tr in arch/arm/boot/compressed/head.S.
+ */
+	.type	n950_trk, #function
+n950_trk:
+	ldr	r3, =0x4E395452
+	str	r3, [r7, #0]			@ magic
+	mov	r3, #1
+	mov	r3, r3, lsl r12
+	ldr	r5, [r7, #4]
