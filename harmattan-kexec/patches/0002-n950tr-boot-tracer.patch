+	subs	r5, r5, #1
+	bne	1b
+2:	sub	r5, r11, #0x200			@ unlock the block: r5 = &regs[0xF100]
+	mov	r3, #N950TR_FBA
+	strh	r3, [r5, #0]			@ START_ADDRESS1
+	mov	r3, #0
+	strh	r3, [r5, #2]			@ START_ADDRESS2
+	mov	r3, #N950TR_FBA
+	strh	r3, [r11, #0x98]		@ START_BLOCK_ADDRESS
+	mov	r3, #0
+	strh	r3, [r11, #0x82]		@ INTERRUPT clear
+	mov	r3, #0x23
+	strh	r3, [r11, #0x40]		@ COMMAND = UNLOCK
+	ldr	r5, =0x100000
+7:	ldrh	r3, [r11, #0x82]
+	tst	r3, #0x8000
+	bne	8f
+	subs	r5, r5, #1
+	bne	7b
+8:	ldrh	r3, [r11, #0x9C]		@ WP_STATUS -> RAM record +28
+	str	r3, [r7, #28]
+	orr	r3, r12, #0xA500
