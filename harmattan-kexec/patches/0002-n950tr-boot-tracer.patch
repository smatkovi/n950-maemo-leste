+	str	r5, [r7, #4]			@ bitmask |= 1 << stage
+	str	r12, [r7, #8]			@ last stage
+	mov	r3, #0
+	str	r3, [r7, #12]
+	str	r3, [r7, #16]
+	ldr	r5, [r7, #20]
+	add	r5, r5, #1
+	str	r5, [r7, #20]			@ counter
+	add	r11, r6, #0x1E000
+	add	r11, r11, #0x400		@ r11 = &regs[0xF200]
+	ldr	r5, =0x100000
