diff --git a/arch/arm/boot/compressed/head.S b/arch/arm/boot/compressed/head.S
index eef810f9..4809d05d 100644
--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -10,6 +10,11 @@
  */
 #include <linux/linkage.h>
 
+/* n950tr: N950 boot tracer addresses (see n950_tr below) */
+#define N950TR_DDR	0x9F000000
+#define N950TR_ONENAND	0x04000000
+#define N950TR_FBA	80
+
 /*
  * Debugging stuff
  *
@@ -133,11 +138,53 @@ start:
 
 		b	1f
 		.word	0x016f2818		@ Magic numbers to help the loader
-		.word	start			@ absolute load/run zImage address
-		.word	_edata			@ zImage end address
+LH_start:	.word	start			@ absolute load/run zImage address
+LH_edata:	.word	_edata			@ zImage end address
+LH_csum:	.word	0			@ n950tr: image checksum, patched post-build
+		.ascii	"N9TR"			@ n950tr: marker (byte offset 0x34)
 1:		mov	r7, r1			@ save architecture ID
 		mov	r8, r2			@ save atags pointer
 
+		/*
+		 * n950tr: boot tracer.  Stage 1 = first instructions of the
+		 * zImage were executed.  Then verify our own image: sum of all
+		 * 32-bit words from start to _edata (the stored checksum word
+		 * counts as 0) must equal LH_csum.  Stage 2 = image intact,
+		 * stage 31 = image corrupted (aux0 = computed, aux1 = expected).
+		 * No stack exists yet; n950_tr clobbers r0-r3, r12, lr only.
+		 */
+		ldr	r3, =N950TR_DDR
+		mov	r12, #0
+		str	r12, [r3, #4]
+		str	r12, [r3, #8]
+		str	r12, [r3, #12]
+		str	r12, [r3, #16]
+		str	r12, [r3, #20]
+		mov	r0, #1
+		mov	r1, #0
+		mov	r2, #0
+		bl	n950_tr
+
+		adr	r3, start		@ runtime address of the image
+		ldr	r12, LH_edata
+		ldr	r1, LH_start
+		sub	r12, r12, r1		@ image length
+		add	r12, r3, r12		@ runtime end address
+		mov	r1, r3
+		mov	r2, #0
+9:		ldr	r0, [r1], #4
+		add	r2, r2, r0
+		cmp	r1, r12
+		blo	9b
+		ldr	r0, LH_csum
+		sub	r2, r2, r0		@ do not count the checksum word itself
+		cmp	r2, r0
+		mov	r1, r2			@ aux0 = computed
+		ldr	r2, LH_csum		@ aux1 = expected
+		moveq	r0, #2
+		movne	r0, #31
+		bl	n950_tr
+
 #ifndef __ARM_ARCH_2__
 		/*
 		 * Booting from Angel - need to enter SVC mode and disable
@@ -241,6 +288,11 @@ not_relocated:	mov	r0, #0
 		 */
 		bl	cache_on
 
+		mov	r0, #3			@ n950tr stage 3: caches/MMU on
+		mov	r1, #0
+		mov	r2, #0
+		bl	n950_tr
+
 		mov	r1, sp			@ malloc space above stack
 		add	r2, sp, #0x10000	@ 64k max
 
@@ -261,10 +313,21 @@ not_relocated:	mov	r0, #0
 		bls	wont_overwrite
 
 		mov	r5, r2			@ decompress after malloc space
+		mov	r0, #4			@ n950tr stage 4: about to decompress
+		mov	r1, #1			@ aux0 = 1: relocating path
+		mov	r2, #0
+		bl	n950_tr
 		mov	r0, r5
 		mov	r3, r7
 		bl	decompress_kernel
 
+		mov	r9, r0			@ n950tr stage 5: decompressed (aux0 = length)
+		mov	r1, r0
+		mov	r0, #5
+		mov	r2, #1
+		bl	n950_tr
+		mov	r0, r9
+
 		add	r0, r0, #127 + 128	@ alignment + stack
 		bic	r0, r0, #127		@ align the kernel length
 /*
@@ -300,11 +363,20 @@ not_relocated:	mov	r0, #0
  * r4     = kernel execution address
  * r7     = architecture ID
  */
-wont_overwrite:	mov	r0, r4
+wont_overwrite:	mov	r0, #4			@ n950tr stage 4: about to decompress
+		mov	r1, #0			@ aux0 = 0: in-place path
+		mov	r2, #0
+		bl	n950_tr
+		mov	r0, r4
 		mov	r3, r7
 		bl	decompress_kernel
+		mov	r1, r0			@ n950tr stage 5: decompressed (aux0 = length)
+		mov	r0, #5
+		mov	r2, #0
+		bl	n950_tr
 		b	call_kernel
 
+
 		.align	2
 		.type	LC0, #object
 LC0:		.word	LC0			@ r1
@@ -571,11 +643,136 @@ reloc_start:	add	r9, r5, r0
 
 call_kernel:	bl	cache_clean_flush
 		bl	cache_off
+		mov	r0, #6			@ n950tr stage 6: jumping to the kernel
+		mov	r1, r4
+		mov	r2, r8
+		bl	n950_tr
 		mov	r0, #0			@ must be zero
 		mov	r1, r7			@ restore architecture number
 		mov	r2, r8			@ restore atags pointer
 		mov	pc, r4			@ call kernel
 
+/*
+ * n950tr - N950 boot tracer (decompressor side).
+ *
+ *  r0 = stage (0..31), r1 = aux0, r2 = aux1.  Clobbers r0-r3, r12, lr.
+ *  Needs no stack.  Works with the MMU off, or on with a 1:1 mapping
+ *  (kexec from a 2.6.32 kernel leaves the MMU on, identity mapped up to
+ *  TASK_SIZE; both addresses below are inside that range).
+ *
+ *  1. RAM record at N950TR_DDR (physical, 8 words):
+ *       +0 magic "N9TR", +4 bitmask of stages seen, +8 last stage,
+ *       +12 aux0, +16 aux1, +20 call counter, +24 OneNAND CTRL_STATUS
+ *       after the last PROG, +28 WP_STATUS after the last UNLOCK.
+ *  2. OneNAND: program page <stage> of flash block N950TR_FBA (inside the
+ *     "log" partition mtd3, which is erased before a test) with the
+ *     page header "N9TR", stage, aux0, aux1 and the fill pattern
+ *     0xA500|stage.  Samsung KFM4G16Q2M (0x50), 4 KiB pages, single
+ *     plane; the sequence is the one onenand_base.c uses for PROG.
+ *     Both waits are bounded so a dead chip cannot hang the boot.
+ */
+
+		.globl	n950_tr
+		.type	n950_tr, #function
+n950_tr:
+		ldr	r3, =N950TR_DDR
+		ldr	r12, =0x4E395452
+		str	r12, [r3, #0]
+		str	r1, [r3, #12]
+		str	r2, [r3, #16]
+		and	r1, r0, #0x1f
+		mov	r2, #1
+		mov	r2, r2, lsl r1
+		ldr	r12, [r3, #4]
+		orr	r12, r12, r2
+		str	r12, [r3, #4]
+		str	r0, [r3, #8]
+		ldr	r12, [r3, #20]
+		add	r12, r12, #1
+		str	r12, [r3, #20]
+		@ save aux0/aux1 for the page header
+		mov	r3, r1			@ r3 = stage & 0x1f (page number)
+		ldr	r12, =N950TR_ONENAND
+		add	r12, r12, #0x1E000
+		add	r12, r12, #0x400	@ r12 = &regs[0xF200] (START_BUFFER)
+		ldr	r1, =0x100000
+1:		ldrh	r2, [r12, #0x82]	@ INTERRUPT
+		tst	r2, #0x8000		@ INT_MASTER: ready?
+		bne	2f
+		subs	r1, r1, #1
+		bne	1b
+2:		@ unlock the block first (power-on state is locked; a PROG to a
+		@ locked block completes silently without writing anything)
+		sub	r1, r12, #0x200		@ r1 = &regs[0xF100]
+		mov	r0, #N950TR_FBA
+		strh	r0, [r1, #0]		@ START_ADDRESS1
+		mov	r0, #0
+		strh	r0, [r1, #2]		@ START_ADDRESS2
+		mov	r0, #N950TR_FBA
+		strh	r0, [r12, #0x98]	@ START_BLOCK_ADDRESS (0xF24C)
+		mov	r0, #0
+		strh	r0, [r12, #0x82]	@ INTERRUPT clear
+		mov	r0, #0x23
+		strh	r0, [r12, #0x40]	@ COMMAND = UNLOCK
+		ldr	r1, =0x100000
+7:		ldrh	r2, [r12, #0x82]
+		tst	r2, #0x8000
+		bne	8f
+		subs	r1, r1, #1
+		bne	7b
+8:		ldrh	r2, [r12, #0x9C]	@ WP_STATUS -> RAM record +28
+		ldr	r1, =N950TR_DDR
+		str	r2, [r1, #28]
+		@ fill DataRAM0 main area (4 KiB) with 0xA500|stage
+		orr	r0, r3, #0xA500
+		ldr	r1, =N950TR_ONENAND + 0x400
+		add	r2, r1, #0x1000
+3:		strh	r0, [r1], #2
+		cmp	r1, r2
+		blo	3b
+		ldr	r1, =N950TR_ONENAND + 0x400
+		ldr	r2, =0x4E395452
+		str	r2, [r1, #0]		@ page header: magic
+		str	r3, [r1, #4]		@ stage
+		ldr	r2, =N950TR_DDR
+		ldr	r0, [r2, #12]
+		str	r0, [r1, #8]		@ aux0
+		ldr	r0, [r2, #16]
+		str	r0, [r1, #12]		@ aux1
+		@ spare area (128 bytes) = 0xFF
+		ldr	r1, =N950TR_ONENAND + 0x10020
+		add	r2, r1, #0x80
+		mvn	r0, #0
+4:		strh	r0, [r1], #2
+		cmp	r1, r2
+		blo	4b
+		@ addresses, then command
+		sub	r1, r12, #0x200		@ r1 = &regs[0xF100] (START_ADDRESS1)
+		mov	r0, #N950TR_FBA
+		strh	r0, [r1, #0]		@ START_ADDRESS1: DFS=0, FBA
+		mov	r0, #0
+		strh	r0, [r1, #2]		@ START_ADDRESS2: DBS=0
+		mov	r0, r3, lsl #2		@ FPA = stage, FSA = 0
+		strh	r0, [r1, #0xE]		@ START_ADDRESS8
+		mov	r0, #0x800
+		strh	r0, [r12, #0]		@ START_BUFFER: BSA=DataRAM0, BSC=0
+		mov	r0, #0
+		strh	r0, [r12, #0x82]	@ INTERRUPT clear
+		mov	r0, #0x80
+		strh	r0, [r12, #0x40]	@ COMMAND = PROG
+		ldr	r1, =0x100000
+5:		ldrh	r2, [r12, #0x82]
+		tst	r2, #0x8000
+		bne	6f
+		subs	r1, r1, #1
+		bne	5b
+6:		ldrh	r2, [r12, #0x80]	@ CTRL_STATUS after PROG -> RAM record +24
+		ldr	r1, =N950TR_DDR
+		str	r2, [r1, #24]
+		mov	pc, lr
+		.size	n950_tr, . - n950_tr
+		.ltorg
+
 /*
  * Here follow the relocatable cache support functions for the
  * various processors.  This is a generic hook for locating an
diff --git a/arch/arm/boot/compressed/misc.c b/arch/arm/boot/compressed/misc.c
index 96282945..0c2e0bdc 100644
--- a/arch/arm/boot/compressed/misc.c
+++ b/arch/arm/boot/compressed/misc.c
@@ -168,8 +168,11 @@ unsigned long free_mem_end_ptr;
 #define arch_error(x)
 #endif
 
+extern void n950_tr(unsigned long stage, unsigned long aux0, unsigned long aux1);
+
 void error(char *x)
 {
+	n950_tr(26, 0, 0);	/* n950tr stage 26: decompressor error() */
 	arch_error(x);
 
 	putstr("\n\n");
diff --git a/arch/arm/include/asm/n950trace.h b/arch/arm/include/asm/n950trace.h
new file mode 100644
index 00000000..f5982526
--- /dev/null
+++ b/arch/arm/include/asm/n950trace.h
@@ -0,0 +1,75 @@
+/*
+ * n950trace.h - Nokia N950 (RM-680) boot tracer
+ *
+ * Debug aid for the "Harmattan 2.6.32 dies silently after kexec" problem.
+ * The decompressor, the early assembly and a few C boot stages record a
+ * stage number in two places that can be read back after the device has
+ * reset:
+ *
+ *  1. A RAM record at physical N950TR_DDR_PA (8 words):
+ *       +0  magic 0x4E395452 ("RT9N" in a hexdump)
+ *       +4  bitmask of stages seen (bit n = stage n)
+ *       +8  last stage, +12 aux0, +16 aux1, +20 call counter,
+ *       +24 OneNAND CTRL_STATUS after the last PROG (bit 10 = error,
+ *           bit 14 = locked), +28 WP_STATUS after the last UNLOCK
+ *           (0x4 unlocked, 0x2 locked, 0x1 lock-tight)
+ *     Survives a reset only if DDR keeps its contents; cheap to try.
+ *
+ *  2. OneNAND: the block is unlocked, then page <stage> of flash block
+ *     N950TR_FBA is programmed with
+ *     the header "N9TR", stage, aux0, aux1 and the fill pattern
+ *     0xA500|stage.  Block 80 is the second block of the "log" partition
+ *     (mtd3 = 2048k@20224k, 256 KiB blocks), i.e. mtd3 offset 0x40000;
+ *     mtdoops uses it only after four oopses.  Erase mtd3 before a test:
+ *       flash_erase /dev/mtd3 0 8
+ *     and read back afterwards with
+ *       dd if=/dev/mtd3 bs=4096 skip=64 count=32 | hexdump -C
+ *     This survives anything, including a battery pull.
+ *
+ * Stages (page numbers):
+ *   decompressor: 1 entry, 2 image checksum OK (31 = checksum FAILED,
+ *     aux0 computed / aux1 expected), 3 caches on, 4 before decompress
+ *     (aux0: 1 = relocating path), 5 after decompress (aux0 = length),
+ *     6 jumping to the kernel (aux0 = entry, aux1 = atags), 26 error()
+ *   kernel asm: 7 stext, 8 page tables built, 9 __enable_mmu,
+ *     10 __mmap_switched, 28/29/30 __error_p/__error_a/__error
+ *   kernel C: 11 start_kernel, 12 before paging_init, 13 after paging_init,
+ *     14 after setup_arch, 15 after mm_init, 16 after init_IRQ,
+ *     17 after time_init, 18 after console_init, 19 rest_init,
+ *     20 kernel_init, 21 before do_basic_setup, 22 omap3_pm_init entry,
+ *     23 omap3_pm_init exit (aux0 = ret), 24 after do_basic_setup,
+ *     25 init_post before exec of init, 27 die(), 0 panic()
+ */
+#ifndef __ASM_ARM_N950TRACE_H
+#define __ASM_ARM_N950TRACE_H
+
+#define N950TR_ONENAND_PA	0x04000000	/* GPMC CS0, see ubiboot dmesg */
+#define N950TR_ONENAND_VA	0xF9000000	/* free slot between L3 and L4 */
+#define N950TR_DDR_PA		0x9F000000	/* mid RAM, below TASK_SIZE */
+#define N950TR_DDR_VA		0xF9100000
+#define N950TR_FBA		80		/* flash block = mtd3 + 256 KiB */
+/* section descriptor: AP=11, TEX/C/B=0 (strongly ordered), XN */
+#define N950TR_SECT_FLAGS	0x00000C12
+
+#ifdef __ASSEMBLY__
+
+	.macro	n950_trk_phys, stage
+	ldr	r6, =N950TR_ONENAND_PA
+	ldr	r7, =N950TR_DDR_PA
+	mov	r12, #\stage
+	bl	n950_trk
+	.endm
+
+	.macro	n950_trk_virt, stage
+	ldr	r6, =N950TR_ONENAND_VA
+	ldr	r7, =N950TR_DDR_VA
+	mov	r12, #\stage
+	bl	n950_trk
+	.endm
+
+#else
+
+void n950_trace(unsigned int stage, unsigned int aux0, unsigned int aux1);
+
+#endif /* __ASSEMBLY__ */
+#endif
