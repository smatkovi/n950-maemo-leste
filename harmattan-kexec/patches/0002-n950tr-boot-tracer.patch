diff --git a/arch/arm/kernel/n950trace.c b/arch/arm/kernel/n950trace.c
new file mode 100644
index 00000000..3ca14591
--- /dev/null
+++ b/arch/arm/kernel/n950trace.c
@@ -0,0 +1,74 @@
+/*
+ * n950trace.c - Nokia N950 boot tracer, C side.  See <asm/n950trace.h>.
+ *
+ * Uses only the two static mappings set up by head.S (before paging_init)
+ * and by omap34xx_io_desc[] (afterwards).  Not __init: it is also called
+ * from panic()/die() and from init_post() after free_initmem().
+ */
+#include <linux/types.h>
+#include <linux/compiler.h>
+#include <asm/n950trace.h>
+
+#define MAGIC	0x4E395452u
+
+static inline void w16(unsigned long a, u16 v) { *(volatile u16 *)a = v; }
+static inline u16 r16(unsigned long a) { return *(volatile u16 *)a; }
+static inline void w32(unsigned long a, u32 v) { *(volatile u32 *)a = v; }
+static inline u32 r32(unsigned long a) { return *(volatile u32 *)a; }
+
+noinline void n950_trace(unsigned int stage, unsigned int aux0,
+			 unsigned int aux1)
+{
+	const unsigned long on = N950TR_ONENAND_VA;
+	const unsigned long ddr = N950TR_DDR_VA;
+	unsigned long i;
+
+	stage &= 0x1f;
+
+	/* RAM record */
+	w32(ddr + 0, MAGIC);
+	w32(ddr + 12, aux0);
+	w32(ddr + 16, aux1);
+	w32(ddr + 4, r32(ddr + 4) | (1u << stage));
+	w32(ddr + 8, stage);
+	w32(ddr + 20, r32(ddr + 20) + 1);
+
+	/* OneNAND: wait until the chip is idle (bounded) */
+	for (i = 0; i < 0x100000; i++)
+		if (r16(on + 0x1E482) & 0x8000)
+			break;
+
+	/* unlock the block (power-on state is locked; harmless if unlocked) */
+	w16(on + 0x1E200, N950TR_FBA);		/* START_ADDRESS1 */
+	w16(on + 0x1E202, 0);			/* START_ADDRESS2 */
+	w16(on + 0x1E498, N950TR_FBA);		/* START_BLOCK_ADDRESS */
+	w16(on + 0x1E482, 0);			/* INTERRUPT clear */
+	w16(on + 0x1E440, 0x23);		/* COMMAND: UNLOCK */
+	for (i = 0; i < 0x100000; i++)
+		if (r16(on + 0x1E482) & 0x8000)
+			break;
+	w32(ddr + 28, r16(on + 0x1E49C));	/* WP_STATUS */
+
+	/* DataRAM0 main area, 4 KiB */
+	for (i = 0; i < 0x1000; i += 2)
+		w16(on + 0x400 + i, 0xA500 | stage);
+	w32(on + 0x400, MAGIC);
+	w32(on + 0x404, stage);
+	w32(on + 0x408, aux0);
+	w32(on + 0x40C, aux1);
+	/* SpareRAM, 128 bytes */
+	for (i = 0; i < 0x80; i += 2)
+		w16(on + 0x10020 + i, 0xFFFF);
+
+	w16(on + 0x1E200, N950TR_FBA);		/* START_ADDRESS1: DFS=0, FBA */
+	w16(on + 0x1E202, 0);			/* START_ADDRESS2: DBS=0 */
+	w16(on + 0x1E20E, (stage & 0x3f) << 2);	/* START_ADDRESS8: FPA, FSA=0 */
+	w16(on + 0x1E400, 0x0800);		/* START_BUFFER: DataRAM0, page */
+	w16(on + 0x1E482, 0);			/* INTERRUPT clear */
+	w16(on + 0x1E440, 0x80);		/* COMMAND: PROG */
+
+	for (i = 0; i < 0x100000; i++)
+		if (r16(on + 0x1E482) & 0x8000)
+			break;
+	w32(ddr + 24, r16(on + 0x1E480));	/* CTRL_STATUS after PROG */
+}
