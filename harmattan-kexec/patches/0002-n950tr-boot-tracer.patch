+	mvn	r3, #0
+4:	strh	r3, [r5], #2
+	tst	r5, #0x80
+	beq	4b
+	sub	r5, r11, #0x200			@ r5 = &regs[0xF100]
+	mov	r3, #N950TR_FBA
+	strh	r3, [r5, #0]			@ START_ADDRESS1: DFS=0, FBA
+	mov	r3, #0
+	strh	r3, [r5, #2]			@ START_ADDRESS2: DBS=0
+	and	r3, r12, #0x3f
+	mov	r3, r3, lsl #2
+	strh	r3, [r5, #0xE]			@ START_ADDRESS8: FPA, FSA=0
+	mov	r3, #0x800
+	strh	r3, [r11, #0]			@ START_BUFFER: DataRAM0, whole page
+	mov	r3, #0
+	strh	r3, [r11, #0x82]		@ INTERRUPT clear
+	mov	r3, #0x80
+	strh	r3, [r11, #0x40]		@ COMMAND = PROG
+	ldr	r5, =0x100000
+5:	ldrh	r3, [r11, #0x82]
+	tst	r3, #0x8000
+	bne	6f
+	subs	r5, r5, #1
+	bne	5b
+6:	ldrh	r3, [r11, #0x80]		@ CTRL_STATUS after PROG -> RAM record +24
+	str	r3, [r7, #24]
