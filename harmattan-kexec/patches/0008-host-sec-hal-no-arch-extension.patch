From da760b872676d65840207c863f740f670db1207e Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 9 Nov 2026 08:02:23 +0100
Subject: [PATCH] omap2: sec_hal_entry.S: drop .arch_extension sec (binutils
 2.19 of CodeSourcery 2009q3 assembles smc with -march=armv7-a without it;
 this is Nokia's original file)

---
 arch/arm/mach-omap2/sec_hal_entry.S | 2 --
 1 file changed, 2 deletions(-)

diff --git a/arch/arm/mach-omap2/sec_hal_entry.S b/arch/arm/mach-omap2/sec_hal_entry.S
index 26355540..9526fbd0 100644
--- a/arch/arm/mach-omap2/sec_hal_entry.S
+++ b/arch/arm/mach-omap2/sec_hal_entry.S
@@ -23,7 +23,6 @@ ENTRY(asm_sec_hal_entry)
 	ldmfd	sp!, {r0-r3}
 	mov	r6, #0xff
 	mov	r12, r0
-	.arch_extension sec
 	smc	#1
 	mov	r11, r0
 	bl	sec_hal_flush_helper
@@ -38,6 +37,5 @@ ENTRY(asm_sec_hal_rpc_handler)
 	bl sec_hal_rpc_handler
 	ldmfd sp!, {r0-r3}
 	mov r12, #0xfc
-	.arch_extension sec
 	smc #1
 ENDPROC(asm_sec_hal_rpc_handler)
-- 
2.56.0

