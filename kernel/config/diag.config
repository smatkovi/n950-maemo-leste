# Diagnostic variant of the N950 kernel: its boot can be watched on the
# display and over USB before any root file system is mounted.
#   DIAG=1 WORK=... bash kernel/build.sh
# merges this on top of n950.config (output in $WORK/out-diag). Not for
# the release image: its modules are not built.

CONFIG_LOCALVERSION="-diag"

# Display from early on: omapdrm with DSI and the N950's panel
# (nokia,himalaya, panel-dsi-cm; its backlight is the panel's own DCS
# brightness), fbdev emulation and fbcon, all built in.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_OMAP=y
CONFIG_OMAP2_DSS_DSI=y
CONFIG_DRM_PANEL_DSI_CM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set

# USB serial console: musb (OMAP2430 glue) with the TWL4030/5030 PHY,
# the legacy serial gadget (CDC ACM, the PC's /dev/ttyACM*) and its
# console (console=ttyGS0). It holds the UDC, so the image's own configfs
# gadget (n950-usbnet) cannot bind.
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_OMAP2PLUS=y
CONFIG_TWL4030_USB=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_OBEX=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
# Leste's -DDEBUG for all gadget code would flood the console
# CONFIG_USB_GADGET_DEBUG is not set

# The log: time stamps, 1 MiB buffer, pstore/ramoops kept.
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=20
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# Watchdogs built in: omap_wdt stops at probe; twl4030_wdt stops at probe
# or, on a TWL5031 that cannot be stopped (patches/diag/0001), is kept
# fed by the watchdog core.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
CONFIG_OMAP_WATCHDOG=y
CONFIG_TWL4030_WATCHDOG=y

# No reboot on panic, so the last screen stays.
CONFIG_PANIC_TIMEOUT=0

# Appended to whatever the boot loader passes (NOLO, MOSLO's kexec), so
# the diagnostic options are there however the kernel was started. Later
# options win (panic=0 over a panic=10); the last console, tty0, is
# /dev/console. fbcon=rotate:3 is the rotation the device tree's panel
# orientation (rotation = <270>) gives fbcon anyway: landscape.
CONFIG_CMDLINE="console=ttyGS0,115200 console=tty0 ignore_loglevel panic=0 fbcon=rotate:3"
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
CONFIG_CMDLINE_EXTEND=y
