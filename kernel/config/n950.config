# The N950 (RM-680) on top of Leste's linux-image-omap configuration
# (6.18, excalibur); merged by kernel/build.sh.

# AK8974 compass (i2c3 0x0f)
CONFIG_AK8974=m
# BH1770GLC / SFH7770 proximity and ambient light (i2c2 0x38)
CONFIG_SENSORS_BH1770=m
# Audio: TWL5031 + TLV320DAC33 + TPA6140A2 on one card
CONFIG_SND_SOC_NOKIA_N950=m
