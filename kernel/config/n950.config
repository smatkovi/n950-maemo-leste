# The N950 (RM-680) on top of Leste's linux-image-omap configuration
# (6.18, excalibur); merged by kernel/build.sh.

# AK8974 compass (i2c3 0x0f)
CONFIG_AK8974=m
# BH1770GLC / SFH7770 proximity and ambient light (i2c2 0x38)
CONFIG_SENSORS_BH1770=m
# Audio: TWL5031 + TLV320DAC33 + TPA6140A2 on one card
CONFIG_SND_SOC_NOKIA_N950=m
# BCM4751 GPS with Nokia's interface (i2c3 0x1fa, 10-bit)
CONFIG_BCM4751_GPS=m
# WL1273 FM radio (i2c3 0x22): the core and the V4L2 receiver, /dev/radio0
CONFIG_MFD_WL1273_CORE=m
CONFIG_RADIO_WL1273=m
# its I2S port on McBSP4, the "N950 FM" card (simple-audio-card)
CONFIG_SND_SOC_WL1273=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_CHARGER_TWL5031_BCC=y
CONFIG_CHARGER_BQ2415X=m
CONFIG_OMAP3_THERMAL=y
CONFIG_USER_NS=y
# for flash swap on the OneNAND's var partition, encrypted like Harmattan's
# (mtdswap + dm-crypt aes-cbc-essiv:sha256 with a random key), once the
# OneNAND probes under Leste (it reads "Manufacturer: Unknown (0xab6c)")
CONFIG_MTD_SWAP=m
CONFIG_MD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_ESSIV=m
