From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 19:06:39 +0100
Subject: [PATCH] ASoC: dt-bindings: Add Nokia N950 and N9 audio

One card: McBSP3 to the TWL5031 codec, McBSP2 to a TLV320DAC33 whose
line output goes through a TPA6140A2 to the headphones, and a GPIO for
the loudspeaker amplifier.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/nokia,n950-audio.yaml      | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml

diff --git a/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml b/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
new file mode 100644
index 000000000..545d97ab3
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/nokia,n950-audio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Nokia N950 and N9 audio
+
+maintainers:
+  - Sebastian Matkovich <sebastian.matkovich@gmail.com>
+
+description:
+  One sound card with two links. McBSP3 connects to the TWL5031 codec
+  (earpiece, loudspeaker, microphones, FM radio input); McBSP2 connects to
+  a TLV320DAC33 whose line output drives the headphones through a
+  TPA6140A2 amplifier. The TWL5031 codec is found by its device name, the
+  other parts by the phandles below.
+
+properties:
+  compatible:
+    const: nokia,n950-audio
+
+  model:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: Name of the sound card; "N950" if not set.
+
+  nokia,cpu-dai:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    description: The two McBSP ports.
+    items:
+      - description: McBSP connected to the TWL5031
+        maxItems: 1
+      - description: McBSP connected to the TLV320DAC33
+        maxItems: 1
+
+  nokia,audio-codec:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The TLV320DAC33.
+
+  nokia,headphone-amplifier:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The TPA6140A2.
+
+  speaker-amplifier-gpios:
+    maxItems: 1
+    description: Enables the loudspeaker amplifier.
+
+required:
+  - compatible
+  - nokia,cpu-dai
+  - nokia,audio-codec
+  - nokia,headphone-amplifier
+  - speaker-amplifier-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    sound {
+        compatible = "nokia,n950-audio";
+        nokia,cpu-dai = <&mcbsp3>, <&mcbsp2>;
+        nokia,audio-codec = <&dac33>;
+        nokia,headphone-amplifier = <&tpa6140a2>;
+        speaker-amplifier-gpios = <&twl_gpio 7 GPIO_ACTIVE_HIGH>;
+    };
-- 
