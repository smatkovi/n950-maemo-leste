From 30fa79a1a3c8213220997914ea13b7bd719ce0bd Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 3 Nov 2026 01:58:28 +0100
Subject: [PATCH] ARM: dts: omap3-n950: the keypad slide's GPIO is high when
 the slide is open

SW_KEYPAD_SLIDE reported the keyboard as closed while it was slid out and
the other way round (measured on an N950: GPIO 109 reads high with the
keyboard open). Hildon then showed its on-screen keyboard while the
hardware keyboard was out. The line is active high.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/ti/omap/omap3-n950.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index 04bee2bd4..e80de6629 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -31,7 +31,7 @@ keys {
 
 		keypad_slide {
 			label = "Keypad Slide";
-			gpios = <&gpio4 13 GPIO_ACTIVE_LOW>; /* 109 */
+			gpios = <&gpio4 13 GPIO_ACTIVE_HIGH>; /* 109, high when open */
 			linux,input-type = <EV_SW>;
 			linux,code = <SW_KEYPAD_SLIDE>;
 			wakeup-source;
-- 
2.56.0

