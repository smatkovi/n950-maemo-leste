From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 19:01:24 +0100
Subject: [PATCH] ASoC: dt-bindings: Add TI TLV320DAC33

The TLV320DAC33 has no device tree binding. Describe it as the driver
uses it: supplies, the reset line (driven active while the chip is on),
the FIFO interrupt, and the two burst-mode options board files used to
set through platform data.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/ti,tlv320dac33.yaml        | 87 +++++++++++++++++++
 1 file changed, 87 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/ti,tlv320dac33.yaml

diff --git a/Documentation/devicetree/bindings/sound/ti,tlv320dac33.yaml b/Documentation/devicetree/bindings/sound/ti,tlv320dac33.yaml
new file mode 100644
index 000000000..53734c4e0
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/ti,tlv320dac33.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/ti,tlv320dac33.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments TLV320DAC33 stereo audio DAC
+
+maintainers:
+  - Peter Ujfalusi <peter.ujfalusi@gmail.com>
+
+description:
+  Low-power stereo DAC with a 24 KB FIFO and a headphone/line output,
+  controlled over I2C.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: ti,tlv320dac33
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: FIFO alarm interrupt, used in the FIFO modes.
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      Line that takes the chip out of reset. The driver drives it active
+      while the chip is powered and inactive while it is off.
+
+  AVDD-supply: true
+  DVDD-supply: true
+  IOVDD-supply: true
+
+  ti,burst-bclkdiv:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    maximum: 255
+    default: 8
+    description: BCLK divider in the FIFO (burst) modes.
+
+  ti,keep-bclk:
+    type: boolean
+    description:
+      Keep BCLK running between bursts in the FIFO modes, for hosts that
+      need a continuous bit clock.
+
+  "#sound-dai-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - AVDD-supply
+  - DVDD-supply
+  - IOVDD-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        codec@19 {
+            compatible = "ti,tlv320dac33";
+            reg = <0x19>;
+            interrupt-parent = <&gpio2>;
+            interrupts = <21 IRQ_TYPE_EDGE_RISING>;
+            reset-gpios = <&gpio2 28 GPIO_ACTIVE_HIGH>;
+            AVDD-supply = <&vaux4>;
+            DVDD-supply = <&vio>;
+            IOVDD-supply = <&vio>;
+            ti,burst-bclkdiv = <3>;
+            ti,keep-bclk;
+            #sound-dai-cells = <0>;
+        };
+    };
-- 
