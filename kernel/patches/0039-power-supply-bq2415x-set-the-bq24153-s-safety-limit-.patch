From 1c3ffda38046ba4a4dbed79ac9f0c04c39f1d926 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 10 Nov 2026 10:09:12 +0100
Subject: [PATCH] power: supply: bq2415x: set the bq24153's safety limit first
 thing at probe

The bq24153(a) clamps VOREG to the VMREG field of its safety limit
register (6), which comes out of power-on reset at 4.20 V. So a 3.8 V
battery that the BSI detection set up for 4.34 V still charged to 4.20 V:
writing 4.34 V to register 2 read back as 4.20 V. Register 6 takes a write
only while no other register has been written since the power-on reset;
on the N950 neither the RESET bit nor a watchdog timeout unlocked it
again.

Write VMREG to exactly the voltage we charge to, before the chip reset and
everything else at probe, and say so in the log when it is already locked
(someone wrote the chip first, or a battery swap with the charger in did
not reset it).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/bq2415x_charger.c | 43 ++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/drivers/power/supply/bq2415x_charger.c b/drivers/power/supply/bq2415x_charger.c
index ab205b279..ec1035b41 100644
--- a/drivers/power/supply/bq2415x_charger.c
+++ b/drivers/power/supply/bq2415x_charger.c
@@ -40,6 +40,7 @@
 #define BQ2415X_REG_VENDER		0x03
 #define BQ2415X_REG_CURRENT		0x04
 #define BQ2415X_REG_SPECIAL		0x05	/* bq24153(a): special charger voltage */
+#define BQ2415X_REG_SAFETY		0x06	/* bq24153(a): safety limits */
 
 /* reset state for all registers */
 #define BQ2415X_RESET_STATUS		BIT(6)
@@ -92,6 +93,9 @@
 /* special charger voltage register (bq24153(a)) */
 #define BQ2415X_BIT_LOW_CHG		5	/* charge current capped at 22.1 mV / Rsense */
 
+/* safety limit register (bq24153(a)) */
+#define BQ2415X_MASK_VMREG		(BIT(0)|BIT(1)|BIT(2)|BIT(3))	/* 4.20 V + n * 20 mV */
+
 
 enum bq2415x_command {
 	BQ2415X_TIMER_RESET,
@@ -745,6 +749,42 @@ static void bq2415x_clear_low_charge(struct bq2415x_device *bq)
 	bq2415x_i2c_write_bit(bq, BQ2415X_REG_SPECIAL, 0, BQ2415X_BIT_LOW_CHG);
 }
 
+/*
+ * The bq24153(a) clamps VOREG to the maximum in its safety limit register
+ * (VMREG, power-on default 4.20 V): a 3.8 V battery the BSI detected stays
+ * at 4.20 V. That register takes a write only as long as no other register
+ * has been written since the chip's power-on reset (battery and VBUS both
+ * gone); neither the RESET bit nor a watchdog timeout unlocks it again
+ * (both tried on the N950). So this has to be the first write at probe.
+ * VMREG is set to exactly the voltage we charge to, which also guards it.
+ */
+static void bq2415x_set_safety_limit(struct bq2415x_device *bq)
+{
+	int mv = bq->init_data.battery_regulation_voltage;
+	int ret, n, limit;
+
+	if (bq->chip != BQ24153 && bq->chip != BQ24153A)
+		return;
+	ret = bq2415x_i2c_read(bq, BQ2415X_REG_SAFETY);
+	if (ret < 0)
+		return;
+	n = clamp(DIV_ROUND_UP(mv - 4200, 20), 0, 15);
+	if ((ret & BQ2415X_MASK_VMREG) != n) {
+		bq2415x_i2c_write(bq, BQ2415X_REG_SAFETY,
+				  (ret & ~BQ2415X_MASK_VMREG) | n);
+		ret = bq2415x_i2c_read(bq, BQ2415X_REG_SAFETY);
+		if (ret < 0)
+			return;
+	}
+	limit = 4200 + 20 * (ret & BQ2415X_MASK_VMREG);
+	if (limit < mv)
+		dev_warn(bq->dev,
+			 "safety limit locked at %d mV (reg 6 %#04x): no %d mV until a power-on reset, i.e. the battery out with no charger connected\n",
+			 limit, ret, mv);
+	else
+		dev_info(bq->dev, "safety limit %d mV (reg 6 %#04x)\n", limit, ret);
+}
+
 /* set default values of all properties */
 static int bq2415x_set_defaults(struct bq2415x_device *bq)
 {
@@ -1741,6 +1781,9 @@ static int bq2415x_probe(struct i2c_client *client)
 
 	bq2415x_detect_battery(bq);
 
+	/* before anything else is written, or it is locked until power-on reset */
+	bq2415x_set_safety_limit(bq);
+
 	bq2415x_reset_chip(bq);
 
 	ret = bq2415x_power_supply_init(bq);
-- 
2.56.0

