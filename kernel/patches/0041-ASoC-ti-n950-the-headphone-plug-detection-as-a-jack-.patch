From 799233508209464e63b1bc544f527f6b1e5912ef Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 10 Nov 2026 14:33:40 +0100
Subject: [PATCH] ASoC: ti: n950: the headphone plug detection as a jack of the
 card

The plug detection (AvPlugDet, TWL5031 GPIO 0) was a gpio-keys switch,
which gives an input event but no jack control, so PipeWire/PulseAudio
could not follow it and kept playing on the loudspeaker. Make it a jack
of the card ("Headphone Jack", from a new hp-det-gpios property of the
sound node): it creates the control for UCM's JackControl and still
reports SW_HEADPHONE_INSERT. Which output plays stays user space's
choice; the jack has no DAPM pins.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/nokia,n950-audio.yaml      |  4 +++
 arch/arm/boot/dts/ti/omap/omap3-n950.dts      | 26 ++++-----------
 sound/soc/ti/n950.c                           | 32 +++++++++++++++++--
 3 files changed, 39 insertions(+), 23 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml b/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
index 545d97ab3..d5fc34362 100644
--- a/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
+++ b/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
@@ -45,6 +45,10 @@ properties:
     maxItems: 1
     description: Enables the loudspeaker amplifier.
 
+  hp-det-gpios:
+    maxItems: 1
+    description: Headphone plug detection (AvPlugDet), active when plugged.
+
 required:
   - compatible
   - nokia,cpu-dai
diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index 9c7993f30..4453d0cf3 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -65,26 +65,6 @@ keypad_slide {
 			pinctrl-0 = <&keypad_slide_pins>;
 		};
 	};
-
-	/*
-	 * The headphone jack's plug detection (AvPlugDet) on TWL5031 GPIO 0,
-	 * low when plugged, pulled up (Nokia's board file; its ACI driver
-	 * reads the line the same way). Telling headsets from headphones and
-	 * their button takes that driver, which mainline has not.
-	 */
-	jack {
-		compatible = "gpio-keys";
-		label = "Headphone Jack";
-
-		switch-headphone {
-			label = "Headphone";
-			gpios = <&twl_gpio 0 GPIO_ACTIVE_LOW>;
-			linux,input-type = <EV_SW>;
-			linux,code = <SW_HEADPHONE_INSERT>;
-			debounce-interval = <50>;
-			wakeup-source;
-		};
-	};
 };
 
 &omap3_pmx_core {
@@ -603,6 +583,12 @@ sound: sound {
 		nokia,audio-codec = <&dac33>;
 		nokia,headphone-amplifier = <&tpa6140a2>;
 		speaker-amplifier-gpios = <&twl_gpio 7 GPIO_ACTIVE_HIGH>;
+		/*
+		 * The headphone jack's plug detection (AvPlugDet) on TWL5031
+		 * GPIO 0, low when plugged (Nokia's board file). As a jack of
+		 * the card, so that user space (PipeWire's UCM) sees it.
+		 */
+		hp-det-gpios = <&twl_gpio 0 GPIO_ACTIVE_LOW>;
 	};
 };
 
diff --git a/sound/soc/ti/n950.c b/sound/soc/ti/n950.c
index 195347cc7..b9b470fa6 100644
--- a/sound/soc/ti/n950.c
+++ b/sound/soc/ti/n950.c
@@ -11,8 +11,9 @@
  *
  * Wiring and settings follow Nokia's dfl61-twl4030.c and
  * dfl61-tlv320dac33.c (Peter Ujfalusi, Nokia Corporation).
- * Headset detection goes through the TWL5031 ACI block, which has no
- * driver yet; there is no jack here.
+ * The plug detection line is a jack of the card; telling headsets from
+ * headphones and their button go through the TWL5031 ACI block, which
+ * has no driver yet.
  */
 
 #include <linux/gpio/consumer.h>
@@ -20,6 +21,7 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <sound/core.h>
+#include <sound/jack.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
 #include <sound/soc.h>
@@ -133,14 +135,38 @@ static const struct snd_kcontrol_new n950_controls[] = {
 	SOC_DAPM_PIN_SWITCH("FM Radio"),
 };
 
+/*
+ * Headphone plug detection (AvPlugDet on a TWL5031 GPIO) as a jack of the
+ * card: a "Headphone Jack" control for user space to switch on (PipeWire's
+ * UCM JackControl) and the SW_HEADPHONE_INSERT input event. Only reported;
+ * which output plays is user space's choice.
+ */
+static struct snd_soc_jack n950_hp_jack;
+static struct snd_soc_jack_gpio n950_hp_jack_gpio = {
+	.name = "hp-det",
+	.report = SND_JACK_HEADPHONE,
+	.debounce_time = 200,
+	.wake = true,
+};
+
 static int n950_twl_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct snd_soc_card *card = rtd->card;
+	int err;
 
 	if (omap_mcbsp_st_add_controls(rtd, 3))
 		dev_warn(card->dev, "No McBSP3 sidetone controls\n");
 
-	return 0;
+	if (!of_property_present(card->dev->of_node, "hp-det-gpios"))
+		return 0;
+
+	err = snd_soc_card_jack_new(card, "Headphone Jack", SND_JACK_HEADPHONE,
+				    &n950_hp_jack);
+	if (err)
+		return err;
+
+	return snd_soc_jack_add_gpiods(card->dev, &n950_hp_jack, 1,
+				       &n950_hp_jack_gpio);
 }
 
 static int n950_dac33_init(struct snd_soc_pcm_runtime *rtd)
-- 
2.56.0

