From a4509352756f36946760c88e4944deefc34745df Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 3 Nov 2026 00:37:37 +0100
Subject: [PATCH 24/25] drm/panel: dsi-cm: Himalaya: landscape, turned by the
 panel, as on Harmattan

The N950 is used in landscape with its keyboard, but its Himalaya panel
(480x864) is mounted for portrait. X's omap driver can only turn the
picture with the DSS's rotation, which OMAP3 without DMM does not have,
so Leste came up in portrait, and the touchscreen (which reports
landscape coordinates) did not match the picture.

Do what Harmattan's panel-nokia-dsi does on the N950 (rotate = 3,
partial area 5/854): set the MY and MV bits of the address mode so that
the panel writes an 854x480 landscape frame into its memory turned, and
let it scan only the 854 visible rows (partial mode). The update window
starts at column 5 then, the first visible row.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-dsi-cm.c | 92 ++++++++++++++++++++++++++--
 1 file changed, 86 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-dsi-cm.c b/drivers/gpu/drm/panel/panel-dsi-cm.c
index d6a6b346c..fd1a7ec88 100644
--- a/drivers/gpu/drm/panel/panel-dsi-cm.c
+++ b/drivers/gpu/drm/panel/panel-dsi-cm.c
@@ -32,7 +32,10 @@ static const struct of_device_id dsicm_of_match[];
 struct dsic_panel_data {
 	u32 xres;
 	u32 yres;
+	u32 x_offset;	/* invisible columns left of the shown ones */
 	u32 y_offset;	/* invisible lines above the shown ones */
+	u8 address_mode;	/* MY, MX and MV bits of the DCS address mode */
+	bool partial;	/* scan only the panel rows that are shown */
 	u32 refresh;
 	u32 width_mm;
 	u32 height_mm;
@@ -185,6 +188,8 @@ static int dsicm_set_update_window(struct panel_drv_data *ddata, int x_offset)
 	struct mipi_dsi_device *dsi = ddata->dsi;
 	int r;
 
+	x_offset += ddata->panel_data->x_offset;
+
 	r = mipi_dsi_dcs_set_column_address(dsi, x_offset,
 					    ddata->mode.hdisplay + x_offset - 1);
 	if (r < 0)
@@ -199,6 +204,66 @@ static int dsicm_set_update_window(struct panel_drv_data *ddata, int x_offset)
 	return 0;
 }
 
+/*
+ * The MY, MX and MV bits (7-5) of the address mode set the order in which
+ * the panel writes a frame into its memory, so the panel itself can turn
+ * the picture.
+ */
+static int dsicm_set_address_mode(struct panel_drv_data *ddata)
+{
+	u8 mode;
+	int r;
+
+	if (!ddata->panel_data->address_mode)
+		return 0;
+
+	r = dsicm_dcs_read_1(ddata, MIPI_DCS_GET_ADDRESS_MODE, &mode);
+	if (r)
+		return r;
+
+	mode &= ~0xe0;
+	mode |= ddata->panel_data->address_mode;
+
+	return dsicm_dcs_write_1(ddata, MIPI_DCS_SET_ADDRESS_MODE, mode);
+}
+
+/* Let the panel scan only its rows that are shown (partial mode). */
+static int dsicm_set_partial_mode(struct panel_drv_data *ddata)
+{
+	const struct dsic_panel_data *pd = ddata->panel_data;
+	u16 start, end;
+	u8 buf[4];
+	ssize_t r;
+
+	if (!pd->partial)
+		return 0;
+
+	/* with rows and columns exchanged (MV), the panel's rows run along x */
+	if (pd->address_mode & BIT(5)) {
+		start = pd->x_offset;
+		end = start + pd->xres - 1;
+	} else {
+		start = pd->y_offset;
+		end = start + pd->yres - 1;
+	}
+
+	buf[0] = start >> 8;
+	buf[1] = start & 0xff;
+	buf[2] = end >> 8;
+	buf[3] = end & 0xff;
+
+	r = mipi_dsi_dcs_write(ddata->dsi, MIPI_DCS_SET_PARTIAL_ROWS,
+			       buf, sizeof(buf));
+	if (r < 0)
+		return r;
+
+	r = mipi_dsi_dcs_write(ddata->dsi, MIPI_DCS_ENTER_PARTIAL_MODE, NULL, 0);
+	if (r < 0)
+		return r;
+
+	return 0;
+}
+
 static int dsicm_amoled_set_backlight(struct panel_drv_data *ddata, u8 level);
 
 static int dsicm_bl_update_status(struct backlight_device *dev)
@@ -653,10 +718,18 @@ static int dsicm_power_on(struct panel_drv_data *ddata)
 	if (r)
 		goto err;
 
+	r = dsicm_set_address_mode(ddata);
+	if (r)
+		goto err;
+
 	r = dsicm_set_update_window(ddata, 0);
 	if (r)
 		goto err;
 
+	r = dsicm_set_partial_mode(ddata);
+	if (r)
+		goto err;
+
 	r = mipi_dsi_dcs_set_display_on(ddata->dsi);
 	if (r)
 		goto err;
@@ -962,14 +1035,21 @@ static const struct dsic_panel_data taal_data = {
 	.te_support = true,
 };
 
-/* 864 lines, of which the top and bottom 5 are not visible */
+/*
+ * 480x864, of which the top and bottom 5 lines are not visible. The N950
+ * is used in landscape with its keyboard, and the panel turns the picture
+ * itself (MY and MV, as Harmattan sets it up), so the mode is the visible
+ * 854x480 in landscape.
+ */
 static const struct dsic_panel_data himalaya_data = {
-	.xres = 480,
-	.yres = 854,
-	.y_offset = 5,
+	.xres = 854,
+	.yres = 480,
+	.x_offset = 5,
+	.address_mode = 0xa0,
+	.partial = true,
 	.refresh = 60,
-	.width_mm = 49,
-	.height_mm = 88,
+	.width_mm = 88,
+	.height_mm = 49,
 	.max_hs_rate = 300000000,
 	.max_lp_rate = 10000000,
 	.te_support = false,
-- 
2.56.0

