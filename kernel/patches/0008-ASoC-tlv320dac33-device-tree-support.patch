From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 19:01:24 +0100
Subject: [PATCH] ASoC: tlv320dac33: device tree support

Match ti,tlv320dac33 so the codec probes and autoloads from a device
tree, and read the burst-mode settings that platform data used to carry:
ti,burst-bclkdiv (BCLK divider in the FIFO modes, default 8) and
ti,keep-bclk (keep BCLK running between bursts). The Nokia N950 and N9
use a divider of 3 with BCLK kept running.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/codecs/tlv320dac33.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/sound/soc/codecs/tlv320dac33.c b/sound/soc/codecs/tlv320dac33.c
index c495be1cf..30d8d0425 100644
--- a/sound/soc/codecs/tlv320dac33.c
+++ b/sound/soc/codecs/tlv320dac33.c
@@ -13,6 +13,8 @@
 #include <linux/delay.h>
 #include <linux/pm.h>
 #include <linux/i2c.h>
+#include <linux/mod_devicetable.h>
+#include <linux/property.h>
 #include <linux/interrupt.h>
 #include <linux/gpio/consumer.h>
 #include <linux/regulator/consumer.h>
@@ -1475,6 +1477,7 @@ static int dac33_i2c_probe(struct i2c_client *client)
 {
 	struct tlv320dac33_priv *dac33;
 	int ret, i;
+	u32 val;
 
 	dac33 = devm_kzalloc(&client->dev, sizeof(struct tlv320dac33_priv),
 			     GFP_KERNEL);
@@ -1492,6 +1495,15 @@ static int dac33_i2c_probe(struct i2c_client *client)
 
 	i2c_set_clientdata(client, dac33);
 
+	if (!device_property_read_u32(&client->dev, "ti,burst-bclkdiv", &val)) {
+		if (!val || val > 255)
+			return dev_err_probe(&client->dev, -EINVAL,
+					     "Invalid ti,burst-bclkdiv %u\n", val);
+		dac33->burst_bclkdiv = val;
+	}
+	dac33->keep_bclk = device_property_read_bool(&client->dev,
+						     "ti,keep-bclk");
+
 	if (!dac33->burst_bclkdiv)
 		dac33->burst_bclkdiv = 8;
 	if (!dac33->mode1_latency)
@@ -1549,9 +1561,16 @@ static const struct i2c_device_id tlv320dac33_i2c_id[] = {
 };
 MODULE_DEVICE_TABLE(i2c, tlv320dac33_i2c_id);
 
+static const struct of_device_id tlv320dac33_of_match[] = {
+	{ .compatible = "ti,tlv320dac33" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tlv320dac33_of_match);
+
 static struct i2c_driver tlv320dac33_i2c_driver = {
 	.driver = {
 		.name = "tlv320dac33-codec",
+		.of_match_table = tlv320dac33_of_match,
 	},
 	.probe		= dac33_i2c_probe,
 	.remove		= dac33_i2c_remove,
-- 
