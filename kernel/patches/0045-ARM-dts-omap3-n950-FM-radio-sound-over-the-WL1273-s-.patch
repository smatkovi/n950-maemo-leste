From b785614881a9fc738d7d05fd7c8881ff565551da Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 10 Nov 2026 16:11:11 +0100
Subject: [PATCH 45/45] ARM: dts: omap3-n950: FM radio sound over the WL1273's
 I2S port

The FM radio played but its sound never arrived: the analog route of
Nokia's audio configuration 4 (to the TWL5031's AUX inputs) carries
silence. FM radio apps under Harmattan record FM sound from the WL1273's
I2S port on McBSP4, which the boot loader muxes to the gpmc_ncs4-7 pads
(mode 2); McBSP4's own pads are the modem's SSI. The chip drives the port
only after a Bluetooth vendor command, which user space sends.

Give the radio its codec node, mux McBSP4 explicitly to those pads and
add a simple-audio-card "N950 FM" with the chip as bit and frame clock
master, as in Nokia's dfl61-wl1273 machine driver. Correct the comment
that said the sound goes to the AUX inputs.

Tested on the N950: after the vendor command, arecord -D hw:FM,0 records
the station (48 kHz, stereo).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/ti/omap/omap3-n950.dts | 56 ++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 4 deletions(-)

diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index 4453d0cf3..a6ff55809 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -649,10 +649,18 @@ gnss@800001fa {
  * FM radio: the FM part of the WL1273 at 0x22 on I2C3, its interrupt on
  * GPIO 43, its reset on GPIO 179, low while off (board-rm680-peripherals.c).
  * Boards up to revision 0x0324 shared GPIO 26 with Bluetooth instead; the
- * N950s sold to developers report revision 1124 at boot. The analog output
- * goes to the TWL5031's AUXL and AUXR inputs, the sound card's "FM Radio"
- * (Nokia's audio configuration 4 for the RM-680). Nokia's board file sets
- * no mux for these pins: they stay as the boot loader set them.
+ * N950s sold to developers report revision 1124 at boot. Nokia's board file
+ * sets no mux for these pins: they stay as the boot loader set them.
+ *
+ * The sound: Nokia's audio configuration 4 for the RM-680 routes an analog
+ * FM line to the TWL5031's AUXL and AUXR inputs, but nothing arrives there.
+ * FM radio apps under Harmattan record it from the chip's I2S port instead,
+ * the "dfl61wl1273" card on McBSP4 that Bluetooth SCO uses as well, with the
+ * chip as clock master. The chip drives that port only after a Bluetooth
+ * vendor command (HCI 0xfc00, f3 88 01 02) with Bluetooth on: user space
+ * sends it before it records. McBSP4 is on the gpmc_ncs4-7 pads (mode 2),
+ * where the boot loader leaves it; its own pads carry SSI to the modem. The
+ * card is "N950 FM" below.
  */
 &i2c3 {
 	fm-radio@22 {
@@ -660,5 +668,45 @@ fm-radio@22 {
 		reg = <0x22>;
 		interrupts-extended = <&gpio2 11 IRQ_TYPE_EDGE_FALLING>;	/* 43 */
 		reset-gpios = <&gpio6 19 GPIO_ACTIVE_LOW>;			/* 179 */
+
+		wl1273_codec: codec {
+			compatible = "ti,wl1273-codec";
+			#sound-dai-cells = <0>;
+		};
+	};
+};
+
+&omap3_pmx_core {
+	mcbsp4_pins: mcbsp4-pins {
+		pinctrl-single,pins = <
+			OMAP3_CORE1_IOPAD(0x20b6, PIN_INPUT | MUX_MODE2)		/* gpmc_ncs4.mcbsp4_clkx */
+			OMAP3_CORE1_IOPAD(0x20b8, PIN_INPUT | MUX_MODE2)		/* gpmc_ncs5.mcbsp4_dr */
+			OMAP3_CORE1_IOPAD(0x20ba, PIN_OUTPUT_PULLDOWN | MUX_MODE2)	/* gpmc_ncs6.mcbsp4_dx */
+			OMAP3_CORE1_IOPAD(0x20bc, PIN_INPUT | MUX_MODE2)		/* gpmc_ncs7.mcbsp4_fsx */
+		>;
+	};
+};
+
+&mcbsp4 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mcbsp4_pins>;
+	status = "okay";
+};
+
+/ {
+	sound-fm {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "N950 FM";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&fm_codec_dai>;
+		simple-audio-card,frame-master = <&fm_codec_dai>;
+
+		simple-audio-card,cpu {
+			sound-dai = <&mcbsp4>;
+		};
+
+		fm_codec_dai: simple-audio-card,codec {
+			sound-dai = <&wl1273_codec>;
+		};
 	};
 };
