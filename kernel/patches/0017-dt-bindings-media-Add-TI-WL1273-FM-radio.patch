From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Thu, 29 Oct 2026 21:33:32 +0100
Subject: [PATCH 17/19] dt-bindings: media: Add TI WL1273 FM radio

The FM part of TI's WL1273 combination chip is an I2C device with an
interrupt line and a reset line of its own. The Nokia N950 and N9 have
it at address 0x22 on the third I2C bus (Nokia's
board-rm680-peripherals.c), its interrupt on GPIO 43 and, on all but
the earliest boards, its reset on GPIO 179.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/media/ti,wl1273-fm.yaml          | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/ti,wl1273-fm.yaml

diff --git a/Documentation/devicetree/bindings/media/ti,wl1273-fm.yaml b/Documentation/devicetree/bindings/media/ti,wl1273-fm.yaml
new file mode 100644
index 000000000..f8715a1a4
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/ti,wl1273-fm.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/ti,wl1273-fm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments WL1273 FM radio
+
+maintainers:
+  - Sebastian Matkovich <sebastian.matkovich@gmail.com>
+
+description:
+  The FM part of the WL1273 WiLink combination chip (Wi-Fi, Bluetooth and
+  FM), controlled over I2C. Its interrupt line tells the host about tuning,
+  seek and RDS events; its own reset (enable) line powers the FM part. The
+  sound leaves the chip as an analog line output or over I2S.
+
+properties:
+  compatible:
+    const: ti,wl1273-fm
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      The FM part's reset line. While it is asserted the FM part is off; the
+      Nokia N950 and N9 drive it low for that, so they tag it GPIO_ACTIVE_LOW.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        fm-radio@22 {
+            compatible = "ti,wl1273-fm";
+            reg = <0x22>;
+            interrupts-extended = <&gpio2 11 IRQ_TYPE_EDGE_FALLING>;
+            reset-gpios = <&gpio6 19 GPIO_ACTIVE_LOW>;
+        };
+    };
-- 
