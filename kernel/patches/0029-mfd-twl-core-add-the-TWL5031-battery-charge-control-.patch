From 529d0544a9256d9ddd5c2630a1f96114d01e01b5 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 9 Nov 2026 10:48:58 +0100
Subject: [PATCH 29/31] mfd: twl-core: add the TWL5031 battery charge control
 (BCC) module

The TWL5031 replaces the TWL4030's BCI with a battery charge control block
at 0xAA on slave 2 (Nokia's twl5031-bcc.c, Harmattan kernel 2.6.32). It
holds the switch that routes VBUS to the external charger IC on the
Nokia N950/N9. Give it a module id so a driver can reach its registers
through twl_i2c_read_u8()/twl_i2c_write_u8().

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/mfd/twl-core.c  | 2 ++
 include/linux/mfd/twl.h | 1 +
 2 files changed, 3 insertions(+)

diff --git a/drivers/mfd/twl-core.c b/drivers/mfd/twl-core.c
index f89eda4a1..979f6cc6e 100644
--- a/drivers/mfd/twl-core.c
+++ b/drivers/mfd/twl-core.c
@@ -79,6 +79,7 @@
 #define TWL4030_BASEADD_KEYPAD		0x00D2
 
 #define TWL5031_BASEADD_ACCESSORY	0x0074 /* Replaces Main Charge */
+#define TWL5031_BASEADD_BCC		0x00AA /* Battery charge control */
 #define TWL5031_BASEADD_INTERRUPTS	0x00B9 /* Different than TWL4030's
 						  one */
 
@@ -198,6 +199,7 @@ static struct twl_mapping twl4030_map[] = {
 
 	{ 2, TWL5031_BASEADD_ACCESSORY },
 	{ 2, TWL5031_BASEADD_INTERRUPTS },
+	{ 2, TWL5031_BASEADD_BCC },
 };
 
 static const struct reg_default twl4030_49_defaults[] = {
diff --git a/include/linux/mfd/twl.h b/include/linux/mfd/twl.h
index b31e07fa4..178b2a65a 100644
--- a/include/linux/mfd/twl.h
+++ b/include/linux/mfd/twl.h
@@ -57,6 +57,7 @@ enum twl4030_module_ids {
 
 	TWL5031_MODULE_ACCESSORY,
 	TWL5031_MODULE_INTERRUPTS,
+	TWL5031_MODULE_BCC,
 
 	TWL4030_MODULE_LAST,
 };
