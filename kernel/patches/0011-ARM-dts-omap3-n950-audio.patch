From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 19:06:39 +0100
Subject: [PATCH] ARM: dts: omap3-n950: audio

Enable McBSP2 and McBSP3, give the TWL5031 its codec node with Nokia's
settings (ramp delay 2, offset cancellation on ARX2), and add the
TLV320DAC33 (i2c2 0x19, IRQ gpio 53, power gpio 60, AVDD from vaux4),
the TPA6140A2 (i2c2 0x60, from vbat) and the sound card, as in Nokia's
board-rm680.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/ti/omap/omap3-n950.dts | 53 ++++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index ddaacb3c8..259be8bca 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -462,3 +462,56 @@ lcd0_in: endpoint {
 		};
 	};
 };
+
+/*
+ * Audio, after Nokia's board-rm680.c: the TWL5031 on McBSP3 drives the
+ * earpiece and, through an amplifier on TWL GPIO 7, the loudspeaker; the
+ * TLV320DAC33 on McBSP2 drives the headphones through a TPA6140A2.
+ */
+/ {
+	sound: sound {
+		compatible = "nokia,n950-audio";
+		model = "N950";
+		nokia,cpu-dai = <&mcbsp3>, <&mcbsp2>;
+		nokia,audio-codec = <&dac33>;
+		nokia,headphone-amplifier = <&tpa6140a2>;
+		speaker-amplifier-gpios = <&twl_gpio 7 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&mcbsp2 {
+	status = "okay";
+};
+
+&mcbsp3 {
+	status = "okay";
+};
+
+&twl_audio {
+	codec {
+		ti,digimic_delay = <0>;
+		ti,ramp_delay_value = <2>;
+		ti,offset_cncl_path = <0x20>;	/* TWL4030_OFFSET_CNCL_SEL_ARX2 */
+	};
+};
+
+&i2c2 {
+	dac33: audio-codec@19 {
+		compatible = "ti,tlv320dac33";
+		reg = <0x19>;
+		interrupts-extended = <&gpio2 21 IRQ_TYPE_EDGE_RISING>; /* 53 */
+		reset-gpios = <&gpio2 28 GPIO_ACTIVE_HIGH>; /* 60 */
+		AVDD-supply = <&vaux4>;
+		DVDD-supply = <&vio>;
+		IOVDD-supply = <&vio>;
+		ti,burst-bclkdiv = <3>;
+		ti,keep-bclk;
+		#sound-dai-cells = <0>;
+	};
+
+	tpa6140a2: amplifier@60 {
+		compatible = "ti,tpa6140a2";
+		reg = <0x60>;
+		Vdd-supply = <&vbat>;
+	};
+};
-- 
