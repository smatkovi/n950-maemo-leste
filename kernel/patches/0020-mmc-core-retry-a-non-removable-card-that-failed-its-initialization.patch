From 9850eac310ffb7db5ee9c085e7c2ba776c7859b9 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 2 Nov 2026 22:55:02 +0100
Subject: [PATCH] mmc: core: retry a non-removable card that failed its
 initialization

The Nokia N950's eMMC at times times out on its first data transfer, the EXT_CSD read (CMD8, -110), after another kernel used it: kexec from MOSLO on 2026-11-02, at boot and after a VEMMC power cycle of 10 s, while the next try found it. A non-removable card is scanned only once, so the boot then waits for its root for ever. Give it five more tries, 200 ms apart.
---
 drivers/mmc/core/core.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/mmc/core/core.c b/drivers/mmc/core/core.c
index 860378bea..9ee7970d9 100644
--- a/drivers/mmc/core/core.c
+++ b/drivers/mmc/core/core.c
@@ -2318,6 +2318,19 @@ void mmc_rescan(struct work_struct *work)
 			break;
 	}
 
+	/*
+	 * A non-removable card gets a few more tries: the Nokia N950's eMMC
+	 * at times times out on its first data transfer (the EXT_CSD read)
+	 * after another kernel used it (a kexec from MOSLO), and is found
+	 * at the next try. There is no later rescan for such a card.
+	 */
+	for (i = 0; i < 5 && !mmc_card_is_removable(host) && !host->bus_ops; i++) {
+		pr_info("%s: retrying the non-removable card (%d)\n",
+			mmc_hostname(host), i + 1);
+		mmc_delay(200);
+		mmc_rescan_try_freq(host, host->f_min);
+	}
+
 	/* A non-removable card should have been detected by now. */
 	if (!mmc_card_is_removable(host) && !host->bus_ops)
 		pr_info("%s: Failed to initialize a non-removable card",
-- 
2.56.0

