From 4516e6119edf51409165ceeed27160d8cd4254e1 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 07:49:40 +0100
Subject: [PATCH] ASoC: ti: n950: headset volume keys by the microphone line's
 voltage

Headsets with volume keys tell them apart by their resistance; all of them
pull the microphone line below comparator 1's 600 mV. Nokia's twl5031-aci
knew one key for a basic headset. On a press, switch the line to the MADC
(ADCIN10, Nokia's vhsmicout path with its 3:2 prescaler) and pick
play/pause, volume up or volume down by its voltage, reported as
SND_JACK_BTN_0/1/2 = KEY_PLAYPAUSE, KEY_VOLUMEUP, KEY_VOLUMEDOWN.

The limits are module parameters (play_max_mv, volup_max_mv); report_mv
logs the voltage of each press and of the idle line, to set them for a
headset. Without the io-channel only the one key is reported.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/nokia,n950-audio.yaml      |  11 +-
 arch/arm/boot/dts/ti/omap/omap3-n950.dts      |   8 +-
 sound/soc/ti/Kconfig                          |   2 +-
 sound/soc/ti/n950.c                           | 118 ++++++++++++++++--
 4 files changed, 123 insertions(+), 16 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml b/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
index 24e9cd474..7c48b589a 100644
--- a/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
+++ b/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
@@ -53,7 +53,7 @@ properties:
     maxItems: 1
     description:
       The TWL5031 ACI (accessory control interface) interrupt, for telling
-      a headset from headphones and for its button.
+      a headset from headphones and for its keys.
 
   interrupt-names:
     const: aci
@@ -61,6 +61,15 @@ properties:
   plug-supply:
     description: Supply of the TWL5031's plug circuitry (VAUX1 on the N950).
 
+  io-channels:
+    maxItems: 1
+    description:
+      The MADC input the ACI connects the headset's microphone line to
+      (TWL5031 ADCIN10); its voltage tells the headset's keys apart.
+
+  io-channel-names:
+    const: hs-mic
+
 required:
   - compatible
   - nokia,cpu-dai
diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index 6d3f3bd26..f1f0248cd 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -590,14 +590,18 @@ sound: sound {
 		 */
 		hp-det-gpios = <&twl_gpio 0 GPIO_ACTIVE_LOW>;
 		/*
-		 * Headset detection and its button: the TWL5031's ACI block,
+		 * Headset detection and its keys: the TWL5031's ACI block,
 		 * whose interrupts reach the TWL PIH as line 6 (the eci_dbi
 		 * SIH). Its plug circuitry runs from VAUX1, Nokia's "v28" for
-		 * twl5031_aci (board-rm680-peripherals.c).
+		 * twl5031_aci (board-rm680-peripherals.c). The ACI switches
+		 * the microphone line to MADC ADCIN10, whose voltage tells
+		 * play/pause from the volume keys.
 		 */
 		interrupts-extended = <&twl 6>;
 		interrupt-names = "aci";
 		plug-supply = <&vaux1>;
+		io-channels = <&twl_madc 10>;
+		io-channel-names = "hs-mic";
 	};
 };
 
diff --git a/sound/soc/ti/Kconfig b/sound/soc/ti/Kconfig
index 25f59a01e..1fdb573d0 100644
--- a/sound/soc/ti/Kconfig
+++ b/sound/soc/ti/Kconfig
@@ -86,7 +86,7 @@ config SND_SOC_NOKIA_RX51
 config SND_SOC_NOKIA_N950
 	tristate "SoC Audio support for Nokia N950 and N9"
 	depends on ARCH_OMAP3 && I2C && GPIOLIB
-	depends on TWL4030_CORE
+	depends on TWL4030_CORE && IIO
 	select SND_SOC_OMAP_MCBSP
 	select SND_SOC_TWL4030
 	select SND_SOC_TLV320DAC33
diff --git a/sound/soc/ti/n950.c b/sound/soc/ti/n950.c
index f7468eab2..aec186f0e 100644
--- a/sound/soc/ti/n950.c
+++ b/sound/soc/ti/n950.c
@@ -15,12 +15,18 @@
  * go through the TWL5031's ACI (accessory control interface) block, after
  * Nokia's twl5031-aci.c for a basic (non-ECI) headset: on a plug its
  * comparator 1 tells a headset (microphone line above 600 mV) from
- * headphones (line grounded), and the button pulls the line below 600 mV,
- * which the ACCINT interrupt reports.
+ * headphones (line grounded), and a button pulls the line below 600 mV,
+ * which the ACCINT interrupt reports. Nokia knew one button there. Headsets
+ * with volume keys tell them apart by their resistance: with the line
+ * switched to the TWL5031's MADC (ADCIN10, Nokia's vhsmicout path), its
+ * voltage picks play/pause, volume up or volume down. The limits are module
+ * parameters (report_mv logs the voltage of each press and of the idle
+ * line).
  */
 
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
+#include <linux/iio/consumer.h>
 #include <linux/input.h>
 #include <linux/interrupt.h>
 #include <linux/mfd/twl.h>
@@ -46,13 +52,33 @@
 #define ACI_ACCESSORY_MODE	BIT(0)	/* in ECI_DBI_CTRL; DBI mode when 0 */
 #define ACI_DISABLE		BIT(1)	/* in ECI_DBI_CTRL */
 #define AV_COMP1_EN		BIT(0)
+#define AV_ADC_SW_EN		BIT(2)	/* microphone line to MADC ADCIN10 */
 #define AV_STATUS_A1_COMP	BIT(3)	/* microphone line below 600 mV */
 #define AV_HOOK_DET_EN		BIT(5)
 
 #define N950_DETECT_DELAY_MS	500	/* plug fully in before measuring */
 #define N950_BUTTON_POLL_MS	20
+#define N950_BUTTONS		(SND_JACK_BTN_0 | SND_JACK_BTN_1 | \
+				 SND_JACK_BTN_2)
+
+/*
+ * Microphone line voltage of a pressed key, upper limits in mV. Measured
+ * with a three-key headset (play/pause, volume up, volume down): line idle
+ * at 1640 mV, keys at 135, 318 and 675 mV; the limits sit halfway between.
+ */
+static unsigned int play_max_mv = 225;
+module_param(play_max_mv, uint, 0644);
+MODULE_PARM_DESC(play_max_mv, "headset play/pause key: line below this (mV)");
+static unsigned int volup_max_mv = 500;
+module_param(volup_max_mv, uint, 0644);
+MODULE_PARM_DESC(volup_max_mv,
+		 "headset volume up key: line below this (mV), volume down above");
+static bool report_mv;
+module_param(report_mv, bool, 0644);
+MODULE_PARM_DESC(report_mv, "log the microphone line voltage of key presses");
 
 struct n950_audio_priv {
+	struct device *dev;
 	struct gpio_desc *speaker_amp_gpio;
 	/* basic headset detection and button through the TWL5031 ACI */
 	int aci_irq;
@@ -62,7 +88,9 @@ struct n950_audio_priv {
 	struct delayed_work plug_work;
 	struct delayed_work button_work;
 	struct mutex aci_lock;
-	bool plugged, headset, pressed;
+	struct iio_channel *mic_adc;	/* ADCIN10, NULL: one button only */
+	bool plugged, headset;
+	int button;			/* SND_JACK_BTN_* held, 0 when none */
 };
 
 static int n950_twl_hw_params(struct snd_pcm_substream *substream,
@@ -216,11 +244,56 @@ static void n950_aci_off(struct n950_audio_priv *priv)
 	n950_aci_accint(false);
 	n950_aci_write(ACI_AV_CTRL, 0);
 	n950_aci_write(ACI_ECI_DBI_CTRL, ACI_DISABLE);
-	if (priv->headset || priv->pressed)
+	if (priv->headset || priv->button)
 		snd_soc_jack_report(&n950_hp_jack, 0,
-				    SND_JACK_MICROPHONE | SND_JACK_BTN_0);
+				    SND_JACK_MICROPHONE | N950_BUTTONS);
 	priv->headset = false;
-	priv->pressed = false;
+	priv->button = 0;
+}
+
+/*
+ * The microphone line's voltage through MADC ADCIN10 (full scale 1.5 V,
+ * ten bits), with Nokia's 3:2 prescaler (MADC_ADCIN10_PRESCALE), in mV.
+ * Comparator 1 stays on; the switch to the ADC is opened again by the
+ * caller's next AV_CTRL write.
+ */
+static int n950_mic_mv(struct n950_audio_priv *priv)
+{
+	int raw, err;
+
+	n950_aci_write(ACI_AV_CTRL, AV_COMP1_EN | AV_ADC_SW_EN);
+	usleep_range(1000, 1500);
+	err = iio_read_channel_raw(priv->mic_adc, &raw);
+	if (err < 0)
+		return err;
+
+	return raw * 1500 * 3 / (1023 * 2);
+}
+
+/* which key holds the line down: by its voltage, or the only one */
+static int n950_which_button(struct n950_audio_priv *priv)
+{
+	int mv, button;
+
+	if (!priv->mic_adc)
+		return SND_JACK_BTN_0;
+
+	mv = n950_mic_mv(priv);
+	if (mv < 0)
+		button = SND_JACK_BTN_0;
+	else if (mv < play_max_mv)
+		button = SND_JACK_BTN_0;
+	else if (mv < volup_max_mv)
+		button = SND_JACK_BTN_1;
+	else
+		button = SND_JACK_BTN_2;
+
+	if (report_mv)
+		dev_info(priv->dev, "headset key at %d mV: %s\n", mv,
+			 button == SND_JACK_BTN_0 ? "play/pause" :
+			 button == SND_JACK_BTN_1 ? "volume up" : "volume down");
+
+	return button;
 }
 
 static void n950_plug_work(struct work_struct *work)
@@ -260,6 +333,11 @@ static void n950_plug_work(struct work_struct *work)
 	}
 
 	priv->headset = true;
+	if (report_mv && priv->mic_adc) {
+		dev_info(priv->dev, "headset line idle at %d mV\n",
+			 n950_mic_mv(priv));
+		n950_aci_write(ACI_AV_CTRL, AV_COMP1_EN | AV_HOOK_DET_EN);
+	}
 	snd_soc_jack_report(&n950_hp_jack, SND_JACK_MICROPHONE,
 			    SND_JACK_MICROPHONE);
 	n950_aci_accint(true);
@@ -267,7 +345,10 @@ static void n950_plug_work(struct work_struct *work)
 	mutex_unlock(&priv->aci_lock);
 }
 
-/* read the button; poll while it is held, then wait for ACCINT again */
+/*
+ * Read the keys: which one on a press (by the line's voltage), then poll
+ * while it is held, then wait for ACCINT again.
+ */
 static void n950_button_work(struct work_struct *work)
 {
 	struct n950_audio_priv *priv = container_of(work, struct n950_audio_priv,
@@ -284,10 +365,13 @@ static void n950_button_work(struct work_struct *work)
 	av = n950_aci_read(ACI_AV_CTRL);
 	pressed = av >= 0 && (av & AV_STATUS_A1_COMP);
 
-	if (pressed != priv->pressed) {
-		priv->pressed = pressed;
-		snd_soc_jack_report(&n950_hp_jack, pressed ? SND_JACK_BTN_0 : 0,
-				    SND_JACK_BTN_0);
+	if (pressed && !priv->button) {
+		priv->button = n950_which_button(priv);
+		n950_aci_write(ACI_AV_CTRL, AV_COMP1_EN);
+		snd_soc_jack_report(&n950_hp_jack, priv->button, N950_BUTTONS);
+	} else if (!pressed && priv->button) {
+		priv->button = 0;
+		snd_soc_jack_report(&n950_hp_jack, 0, N950_BUTTONS);
 	}
 
 	if (pressed) {
@@ -366,6 +450,8 @@ static int n950_aci_init(struct snd_soc_card *card)
 		return 0;
 
 	snd_jack_set_key(n950_hp_jack.jack, SND_JACK_BTN_0, KEY_PLAYPAUSE);
+	snd_jack_set_key(n950_hp_jack.jack, SND_JACK_BTN_1, KEY_VOLUMEUP);
+	snd_jack_set_key(n950_hp_jack.jack, SND_JACK_BTN_2, KEY_VOLUMEDOWN);
 
 	n950_aci_accint(false);
 	err = devm_request_threaded_irq(card->dev, priv->aci_irq, NULL,
@@ -398,7 +484,7 @@ static int n950_twl_init(struct snd_soc_pcm_runtime *rtd)
 
 	err = snd_soc_card_jack_new(card, "Headphone Jack",
 				    SND_JACK_HEADPHONE | SND_JACK_MICROPHONE |
-				    SND_JACK_BTN_0, &n950_hp_jack);
+				    N950_BUTTONS, &n950_hp_jack);
 	if (err)
 		return err;
 
@@ -556,6 +642,14 @@ static int n950_audio_probe(struct platform_device *pdev)
 			return -EPROBE_DEFER;
 		priv->plug_supply = NULL;
 	}
+	/* optional: the microphone line on MADC ADCIN10 tells the keys apart */
+	priv->mic_adc = devm_iio_channel_get(dev, "hs-mic");
+	if (IS_ERR(priv->mic_adc)) {
+		if (PTR_ERR(priv->mic_adc) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		priv->mic_adc = NULL;
+	}
+	priv->dev = dev;
 	mutex_init(&priv->aci_lock);
 	INIT_DELAYED_WORK(&priv->plug_work, n950_plug_work);
 	INIT_DELAYED_WORK(&priv->button_work, n950_button_work);
-- 
2.56.0

