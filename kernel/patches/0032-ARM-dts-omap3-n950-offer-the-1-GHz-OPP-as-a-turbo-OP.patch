From 659972b8e747192f26540161731beb50854f37ce Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 9 Nov 2026 12:06:55 +0100
Subject: [PATCH 32/32] ARM: dts: omap3-n950: offer the 1 GHz OPP as a turbo
 OPP

The N950's OMAP3630 is not speed-binned for 1 GHz (CONTROL_DEVICE_STATUS bit 9
is clear), but Harmattan runs it at 1 GHz. Accept OPP1G on this part; it stays
a turbo OPP, used only while cpufreq's boost switch is on, and the cpu thermal
zone (CONFIG_OMAP3_THERMAL) throttles it at 80 C.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/arm/boot/dts/ti/omap/omap3-n950.dts | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index 4bcbc0282..cf08defb7 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -159,6 +159,19 @@ &modem {
 	compatible = "nokia,n950-modem";
 };
 
+/*
+ * The OMAP3630 in the N950 is not speed-binned for 1 GHz (CONTROL_DEVICE_STATUS
+ * bit 9 is clear), but Harmattan runs it at 1 GHz. Offer OPP1G anyway, as a
+ * turbo OPP: it is used only while /sys/devices/system/cpu/cpufreq/boost is 1.
+ * CONFIG_OMAP3_THERMAL gives the cpu thermal zone (passive 80 C, critical 90 C)
+ * that throttles it.
+ */
+&cpu0_opp_table {
+	opp-1000000000 {
+		opp-supported-hw = <0xffffffff 3>;
+	};
+};
+
 &twl {
 	/*
 	 * Battery charge control: the switch between VBUS and the bq24153a.
