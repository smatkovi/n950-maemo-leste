From d4cde5c3f4a836e4cc74f49fd77648b338ee5fa0 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 00:29:16 +0100
Subject: [PATCH] ASoC: ti: n950: basic headset detection and its button
 (TWL5031 ACI)

Headsets and their button go through the TWL5031's ACI (accessory
control interface) block, which mainline has no driver for. Do what
Nokia's twl5031-aci.c does for a basic (non-ECI) headset, inside the
card's jack handling:

- on a plug (the existing hp-det jack), put the ACI block in accessory
  mode with comparator 1 and hook detection on; comparator 1 low (the
  microphone line below 600 mV) means the microphone contact is
  grounded, i.e. headphones; otherwise a headset: report
  SND_JACK_MICROPHONE and enable ACCINT;
- the button pulls the microphone line below 600 mV: on ACCINT read
  comparator 1, report SND_JACK_BTN_0 (KEY_PLAYPAUSE), poll every 20 ms
  while it is held, then wait for ACCINT again;
- on unplug switch the block off and release the microphone and button.

The ACI interrupt reaches the TWL PIH as line 6 (the eci_dbi SIH, whose
registers ACIIDR/ACIIMR this driver handles itself, like Nokia's). The
plug circuitry runs from VAUX1 (Nokia's "v28" supply for twl5031_aci),
an optional plug-supply. Both are optional in the binding; without the
interrupt the card behaves as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/nokia,n950-audio.yaml      |  12 +
 arch/arm/boot/dts/ti/omap/omap3-n950.dts      |   9 +
 sound/soc/ti/n950.c                           | 272 +++++++++++++++++-
 3 files changed, 285 insertions(+), 8 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml b/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
index d5fc34362..24e9cd474 100644
--- a/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
+++ b/Documentation/devicetree/bindings/sound/nokia,n950-audio.yaml
@@ -49,6 +49,18 @@ properties:
     maxItems: 1
     description: Headphone plug detection (AvPlugDet), active when plugged.
 
+  interrupts:
+    maxItems: 1
+    description:
+      The TWL5031 ACI (accessory control interface) interrupt, for telling
+      a headset from headphones and for its button.
+
+  interrupt-names:
+    const: aci
+
+  plug-supply:
+    description: Supply of the TWL5031's plug circuitry (VAUX1 on the N950).
+
 required:
   - compatible
   - nokia,cpu-dai
diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index a6ff55809..6d3f3bd26 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -589,6 +589,15 @@ sound: sound {
 		 * the card, so that user space (PipeWire's UCM) sees it.
 		 */
 		hp-det-gpios = <&twl_gpio 0 GPIO_ACTIVE_LOW>;
+		/*
+		 * Headset detection and its button: the TWL5031's ACI block,
+		 * whose interrupts reach the TWL PIH as line 6 (the eci_dbi
+		 * SIH). Its plug circuitry runs from VAUX1, Nokia's "v28" for
+		 * twl5031_aci (board-rm680-peripherals.c).
+		 */
+		interrupts-extended = <&twl 6>;
+		interrupt-names = "aci";
+		plug-supply = <&vaux1>;
 	};
 };
 
diff --git a/sound/soc/ti/n950.c b/sound/soc/ti/n950.c
index b9b470fa6..f7468eab2 100644
--- a/sound/soc/ti/n950.c
+++ b/sound/soc/ti/n950.c
@@ -11,15 +11,25 @@
  *
  * Wiring and settings follow Nokia's dfl61-twl4030.c and
  * dfl61-tlv320dac33.c (Peter Ujfalusi, Nokia Corporation).
- * The plug detection line is a jack of the card; telling headsets from
- * headphones and their button go through the TWL5031 ACI block, which
- * has no driver yet.
+ * The plug detection line is a jack of the card. Headsets and their button
+ * go through the TWL5031's ACI (accessory control interface) block, after
+ * Nokia's twl5031-aci.c for a basic (non-ECI) headset: on a plug its
+ * comparator 1 tells a headset (microphone line above 600 mV) from
+ * headphones (line grounded), and the button pulls the line below 600 mV,
+ * which the ACCINT interrupt reports.
  */
 
+#include <linux/delay.h>
 #include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/twl.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/of_irq.h>
 #include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
 #include <sound/core.h>
 #include <sound/jack.h>
 #include <sound/pcm.h>
@@ -29,8 +39,30 @@
 #include "omap-mcbsp.h"
 #include "../codecs/tlv320dac33.h"
 
+/* TWL5031 ACI registers (module ACCESSORY) and bits, from Nokia's aci.h */
+#define ACI_ECI_DBI_CTRL	0x0b
+#define ACI_AV_CTRL		0x0c
+#define ACI_ACCINT		BIT(0)	/* in ACIIDR/ACIIMR */
+#define ACI_ACCESSORY_MODE	BIT(0)	/* in ECI_DBI_CTRL; DBI mode when 0 */
+#define ACI_DISABLE		BIT(1)	/* in ECI_DBI_CTRL */
+#define AV_COMP1_EN		BIT(0)
+#define AV_STATUS_A1_COMP	BIT(3)	/* microphone line below 600 mV */
+#define AV_HOOK_DET_EN		BIT(5)
+
+#define N950_DETECT_DELAY_MS	500	/* plug fully in before measuring */
+#define N950_BUTTON_POLL_MS	20
+
 struct n950_audio_priv {
 	struct gpio_desc *speaker_amp_gpio;
+	/* basic headset detection and button through the TWL5031 ACI */
+	int aci_irq;
+	struct regulator *plug_supply;
+	bool plug_supply_on;
+	struct notifier_block jack_nb;
+	struct delayed_work plug_work;
+	struct delayed_work button_work;
+	struct mutex aci_lock;
+	bool plugged, headset, pressed;
 };
 
 static int n950_twl_hw_params(struct snd_pcm_substream *substream,
@@ -149,6 +181,210 @@ static struct snd_soc_jack_gpio n950_hp_jack_gpio = {
 	.wake = true,
 };
 
+static int n950_aci_read(u8 reg)
+{
+	u8 val;
+	int err = twl_i2c_read_u8(TWL5031_MODULE_ACCESSORY, &val, reg);
+
+	return err ? err : val;
+}
+
+static void n950_aci_write(u8 reg, u8 val)
+{
+	twl_i2c_write_u8(TWL5031_MODULE_ACCESSORY, val, reg);
+}
+
+/* the ACCINT interrupt on (cleared first) or off */
+static void n950_aci_accint(bool on)
+{
+	int imr = n950_aci_read(TWL5031_ACIIMR_LSB);
+
+	if (imr < 0)
+		return;
+	if (on) {
+		n950_aci_write(TWL5031_ACIIDR_LSB, ACI_ACCINT);
+		imr &= ~ACI_ACCINT;
+	} else {
+		imr |= ACI_ACCINT;
+	}
+	n950_aci_write(TWL5031_ACIIMR_LSB, imr);
+}
+
+/* nothing plugged, or headphones without a microphone: the ACI block off */
+static void n950_aci_off(struct n950_audio_priv *priv)
+{
+	n950_aci_accint(false);
+	n950_aci_write(ACI_AV_CTRL, 0);
+	n950_aci_write(ACI_ECI_DBI_CTRL, ACI_DISABLE);
+	if (priv->headset || priv->pressed)
+		snd_soc_jack_report(&n950_hp_jack, 0,
+				    SND_JACK_MICROPHONE | SND_JACK_BTN_0);
+	priv->headset = false;
+	priv->pressed = false;
+}
+
+static void n950_plug_work(struct work_struct *work)
+{
+	struct n950_audio_priv *priv = container_of(work, struct n950_audio_priv,
+						    plug_work.work);
+	bool plugged = n950_hp_jack.status & SND_JACK_HEADPHONE;
+	int av;
+
+	cancel_delayed_work_sync(&priv->button_work);
+	mutex_lock(&priv->aci_lock);
+
+	if (!plugged) {
+		n950_aci_off(priv);
+		if (priv->plug_supply_on) {
+			regulator_disable(priv->plug_supply);
+			priv->plug_supply_on = false;
+		}
+		goto out;
+	}
+
+	if (priv->plug_supply && !priv->plug_supply_on &&
+	    !regulator_enable(priv->plug_supply)) {
+		priv->plug_supply_on = true;
+		msleep(20);
+	}
+
+	/* ACI on in accessory mode, comparator 1 and hook detection */
+	n950_aci_write(ACI_ECI_DBI_CTRL, ACI_ACCESSORY_MODE);
+	n950_aci_write(ACI_AV_CTRL, AV_COMP1_EN | AV_HOOK_DET_EN);
+	msleep(100);
+	av = n950_aci_read(ACI_AV_CTRL);
+	if (av < 0 || (av & AV_STATUS_A1_COMP)) {
+		/* the microphone contact is grounded: headphones */
+		n950_aci_off(priv);
+		goto out;
+	}
+
+	priv->headset = true;
+	snd_soc_jack_report(&n950_hp_jack, SND_JACK_MICROPHONE,
+			    SND_JACK_MICROPHONE);
+	n950_aci_accint(true);
+out:
+	mutex_unlock(&priv->aci_lock);
+}
+
+/* read the button; poll while it is held, then wait for ACCINT again */
+static void n950_button_work(struct work_struct *work)
+{
+	struct n950_audio_priv *priv = container_of(work, struct n950_audio_priv,
+						    button_work.work);
+	bool pressed;
+	int av;
+
+	mutex_lock(&priv->aci_lock);
+	if (!priv->headset)
+		goto out;
+
+	n950_aci_write(ACI_AV_CTRL, AV_COMP1_EN);
+	usleep_range(100, 200);
+	av = n950_aci_read(ACI_AV_CTRL);
+	pressed = av >= 0 && (av & AV_STATUS_A1_COMP);
+
+	if (pressed != priv->pressed) {
+		priv->pressed = pressed;
+		snd_soc_jack_report(&n950_hp_jack, pressed ? SND_JACK_BTN_0 : 0,
+				    SND_JACK_BTN_0);
+	}
+
+	if (pressed) {
+		schedule_delayed_work(&priv->button_work,
+				      msecs_to_jiffies(N950_BUTTON_POLL_MS));
+	} else {
+		n950_aci_write(ACI_AV_CTRL, AV_COMP1_EN | AV_HOOK_DET_EN);
+		n950_aci_accint(true);
+	}
+out:
+	mutex_unlock(&priv->aci_lock);
+}
+
+/* ACI interrupt (TWL5031 PIH line 6): clear it, hand ACCINT to the work */
+static irqreturn_t n950_aci_irq(int irq, void *data)
+{
+	struct n950_audio_priv *priv = data;
+	int lsb = n950_aci_read(TWL5031_ACIIDR_LSB);
+	int msb = n950_aci_read(TWL5031_ACIIDR_MSB);
+
+	if (lsb < 0 || msb < 0)
+		return IRQ_NONE;
+	n950_aci_write(TWL5031_ACIIDR_MSB, msb);
+	n950_aci_write(TWL5031_ACIIDR_LSB, lsb);
+
+	if ((lsb & ACI_ACCINT) && priv->headset) {
+		n950_aci_accint(false);
+		/* a short debounce before the first reading */
+		mod_delayed_work(system_wq, &priv->button_work,
+				 msecs_to_jiffies(N950_BUTTON_POLL_MS));
+	}
+
+	return IRQ_HANDLED;
+}
+
+static int n950_jack_event(struct notifier_block *nb, unsigned long status,
+			   void *data)
+{
+	struct n950_audio_priv *priv = container_of(nb, struct n950_audio_priv,
+						    jack_nb);
+	bool plugged = status & SND_JACK_HEADPHONE;
+
+	if (plugged == priv->plugged)
+		return NOTIFY_OK;
+	priv->plugged = plugged;
+	mod_delayed_work(system_wq, &priv->plug_work,
+			 plugged ? msecs_to_jiffies(N950_DETECT_DELAY_MS) : 0);
+
+	return NOTIFY_OK;
+}
+
+static void n950_aci_cleanup(void *data)
+{
+	struct n950_audio_priv *priv = data;
+
+	if (priv->jack_nb.notifier_call)
+		snd_soc_jack_notifier_unregister(&n950_hp_jack, &priv->jack_nb);
+	cancel_delayed_work_sync(&priv->plug_work);
+	cancel_delayed_work_sync(&priv->button_work);
+	mutex_lock(&priv->aci_lock);
+	priv->headset = false;
+	n950_aci_accint(false);
+	n950_aci_write(ACI_AV_CTRL, 0);
+	n950_aci_write(ACI_ECI_DBI_CTRL, ACI_DISABLE);
+	mutex_unlock(&priv->aci_lock);
+	if (priv->plug_supply_on)
+		regulator_disable(priv->plug_supply);
+}
+
+static int n950_aci_init(struct snd_soc_card *card)
+{
+	struct n950_audio_priv *priv = snd_soc_card_get_drvdata(card);
+	int err;
+
+	if (priv->aci_irq <= 0)
+		return 0;
+
+	snd_jack_set_key(n950_hp_jack.jack, SND_JACK_BTN_0, KEY_PLAYPAUSE);
+
+	n950_aci_accint(false);
+	err = devm_request_threaded_irq(card->dev, priv->aci_irq, NULL,
+					n950_aci_irq, IRQF_ONESHOT,
+					"n950-aci", priv);
+	if (err)
+		return dev_err_probe(card->dev, err, "ACI interrupt\n");
+
+	priv->jack_nb.notifier_call = n950_jack_event;
+	snd_soc_jack_notifier_register(&n950_hp_jack, &priv->jack_nb);
+	/* a plug already in at boot */
+	if (n950_hp_jack.status & SND_JACK_HEADPHONE) {
+		priv->plugged = true;
+		schedule_delayed_work(&priv->plug_work, 0);
+	}
+
+	return 0;
+}
+
 static int n950_twl_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct snd_soc_card *card = rtd->card;
@@ -160,13 +396,18 @@ static int n950_twl_init(struct snd_soc_pcm_runtime *rtd)
 	if (!of_property_present(card->dev->of_node, "hp-det-gpios"))
 		return 0;
 
-	err = snd_soc_card_jack_new(card, "Headphone Jack", SND_JACK_HEADPHONE,
-				    &n950_hp_jack);
+	err = snd_soc_card_jack_new(card, "Headphone Jack",
+				    SND_JACK_HEADPHONE | SND_JACK_MICROPHONE |
+				    SND_JACK_BTN_0, &n950_hp_jack);
+	if (err)
+		return err;
+
+	err = snd_soc_jack_add_gpiods(card->dev, &n950_hp_jack, 1,
+				      &n950_hp_jack_gpio);
 	if (err)
 		return err;
 
-	return snd_soc_jack_add_gpiods(card->dev, &n950_hp_jack, 1,
-				       &n950_hp_jack_gpio);
+	return n950_aci_init(card);
 }
 
 static int n950_dac33_init(struct snd_soc_pcm_runtime *rtd)
@@ -305,13 +546,28 @@ static int n950_audio_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(priv->speaker_amp_gpio),
 				     "could not get speaker amplifier gpio\n");
 
+	/* optional: the ACI interrupt for headset detection and its button */
+	priv->aci_irq = of_irq_get_byname(dev->of_node, "aci");
+	if (priv->aci_irq == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
+	priv->plug_supply = devm_regulator_get_optional(dev, "plug");
+	if (IS_ERR(priv->plug_supply)) {
+		if (PTR_ERR(priv->plug_supply) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		priv->plug_supply = NULL;
+	}
+	mutex_init(&priv->aci_lock);
+	INIT_DELAYED_WORK(&priv->plug_work, n950_plug_work);
+	INIT_DELAYED_WORK(&priv->button_work, n950_button_work);
+
 	snd_soc_card_set_drvdata(card, priv);
 
 	err = devm_snd_soc_register_card(dev, card);
 	if (err)
 		return dev_err_probe(dev, err, "could not register the card\n");
 
-	return 0;
+	/* runs before the card goes: no ACI work after it */
+	return devm_add_action_or_reset(dev, n950_aci_cleanup, priv);
 }
 
 static const struct of_device_id n950_audio_of_match[] = {
-- 
