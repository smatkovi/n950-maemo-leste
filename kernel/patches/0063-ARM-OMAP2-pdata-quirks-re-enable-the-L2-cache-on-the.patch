From dd6e4f4e7013730713e9a3cceab7efe087e97039 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Thu, 26 Nov 2026 14:11:19 +0100
Subject: [PATCH] ARM: OMAP2+: pdata-quirks: re-enable the L2 cache on the
 Nokia N9/N950

ubiboot clears the Cortex-A8 L2 cache enable (ACR bit 1) before it kexecs
the kernel, and mainline OMAP3 never re-enables it, so the N9/N950 run
with L2 disabled after a ubiboot boot.

Set L2EN with a direct ACR write after cleaning and invalidating all
cache levels by set/way with interrupts off, as Harmattan's kernel does
in cpu_v7_proc_init (UbiBoot's l2fix); the N950 takes that write. Only
if it is ignored, try the secure monitor (PPA services 40 and 42, the
order of the OFF-mode restore): that route returns 64 on the N950 and
leaves L2 off. Leave an L2 that is already on alone and log the result.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/mach-omap2/omap-secure.c  | 14 ++++++++
 arch/arm/mach-omap2/omap-secure.h  |  1 +
 arch/arm/mach-omap2/pdata-quirks.c | 56 ++++++++++++++++++++++++++++--
 3 files changed, 69 insertions(+), 2 deletions(-)

diff --git a/arch/arm/mach-omap2/omap-secure.c b/arch/arm/mach-omap2/omap-secure.c
index c2e1aecd0..86f257147 100644
--- a/arch/arm/mach-omap2/omap-secure.c
+++ b/arch/arm/mach-omap2/omap-secure.c
@@ -202,6 +202,20 @@ u32 rx51_secure_update_aux_cr(u32 set_bits, u32 clear_bits)
 				      1, acr, 0, 0, 0);
 }
 
+/**
+ * rx51_secure_l2_inval: invalidate the L2 cache (PPA service 40), as the
+ * OMAP3 OFF-mode restore does before it sets L2EN again
+ *
+ * Return the non-zero error value on failure.
+ */
+u32 rx51_secure_l2_inval(void)
+{
+	return rx51_secure_dispatcher(RX51_PPA_L2_INVAL,
+				      0,
+				      FLAG_START_CRITICAL,
+				      0, 0, 0, 0, 0);
+}
+
 /**
  * rx51_secure_rng_call: Routine for HW random generator
  */
diff --git a/arch/arm/mach-omap2/omap-secure.h b/arch/arm/mach-omap2/omap-secure.h
index 2517c4a5a..f17d7279d 100644
--- a/arch/arm/mach-omap2/omap-secure.h
+++ b/arch/arm/mach-omap2/omap-secure.h
@@ -75,6 +75,7 @@ extern u32 save_secure_ram_context(u32 args_pa);
 extern u32 omap3_save_secure_ram(void *save_regs, int size);
 
 extern u32 rx51_secure_update_aux_cr(u32 set_bits, u32 clear_bits);
+extern u32 rx51_secure_l2_inval(void);
 extern u32 rx51_secure_rng_call(u32 ptr, u32 count, u32 flag);
 
 extern bool optee_available;
diff --git a/arch/arm/mach-omap2/pdata-quirks.c b/arch/arm/mach-omap2/pdata-quirks.c
index 7dab5aac9..b34ef9f6c 100644
--- a/arch/arm/mach-omap2/pdata-quirks.c
+++ b/arch/arm/mach-omap2/pdata-quirks.c
@@ -25,6 +25,8 @@
 #include <linux/platform_data/asoc-ti-mcbsp.h>
 #include <linux/platform_data/ti-prm.h>
 
+#include <asm/cacheflush.h>
+
 #include "clockdomain.h"
 #include "common.h"
 #include "common-board-devices.h"
@@ -258,6 +260,56 @@ static void __init nokia_n900_legacy_init(void)
 	}
 }
 
+static void __init nokia_n9_n950_legacy_init(void)
+{
+	unsigned long flags;
+	u32 before, direct, after, ret_inval = 0, ret_acr = 0;
+
+	hsmmc2_internal_input_clk();
+
+	/*
+	 * ubiboot clears the Cortex-A8 L2 cache enable (ACR bit 1) before it
+	 * kexecs the kernel, and mainline OMAP3 never re-enables it (it relies
+	 * on the boot loader). Without this the N9/N950 run with L2 disabled.
+	 * Never touch an L2 that is already on: invalidating a live L2 would
+	 * throw away dirty lines.
+	 */
+	asm volatile ("mrc p15, 0, %0, c1, c0, 1" : "=r" (before));
+	if (before & BIT(1)) {
+		pr_info("N9/N950: L2 cache already enabled (ACR %#x)\n", before);
+		return;
+	}
+
+	/*
+	 * The N950 takes a direct ACR write: Harmattan's kernel sets L2EN this
+	 * way in cpu_v7_proc_init (UbiBoot's l2fix), and it works on a running
+	 * N950 as well. Clean and invalidate all cache levels by set/way first,
+	 * with interrupts off, so the L2 starts without stale lines.
+	 */
+	local_irq_save(flags);
+	flush_cache_all();
+	asm volatile ("mcr p15, 0, %0, c1, c0, 1" : : "r" (before | BIT(1)) : "memory");
+	isb();
+	asm volatile ("mrc p15, 0, %0, c1, c0, 1" : "=r" (direct));
+	local_irq_restore(flags);
+
+	/*
+	 * Where the write is ignored (a production HS N9 may only take it in
+	 * the secure world), go through the secure monitor in the order the
+	 * OFF-mode restore in sleep34xx.S uses (PPA services 40 and 42).
+	 */
+	after = direct;
+	if (!(direct & BIT(1)) && omap_type() != OMAP2_DEVICE_TYPE_GP) {
+		ret_inval = rx51_secure_l2_inval();
+		ret_acr = rx51_secure_update_aux_cr(BIT(1), 0);
+		asm volatile ("mrc p15, 0, %0, c1, c0, 1" : "=r" (after));
+	}
+	pr_info("N9/N950: L2 cache %s (ACR %#x -> %#x, direct write %s, PPA inval %u, acr %u)\n",
+		(after & BIT(1)) ? "re-enabled" : "still disabled",
+		before, after, (direct & BIT(1)) ? "took" : "ignored",
+		ret_inval, ret_acr);
+}
+
 static void __init omap3_tao3530_legacy_init(void)
 {
 	hsmmc2_internal_input_clk();
@@ -513,8 +565,8 @@ static struct pdata_init pdata_quirks[] __initdata = {
 	{ "compulab,omap3-sbc-t3530", omap3_sbc_t3530_legacy_init, },
 	{ "compulab,omap3-sbc-t3730", omap3_sbc_t3730_legacy_init, },
 	{ "nokia,omap3-n900", nokia_n900_legacy_init, },
-	{ "nokia,omap3-n9", hsmmc2_internal_input_clk, },
-	{ "nokia,omap3-n950", hsmmc2_internal_input_clk, },
+	{ "nokia,omap3-n9", nokia_n9_n950_legacy_init, },
+	{ "nokia,omap3-n950", nokia_n9_n950_legacy_init, },
 	{ "logicpd,dm3730-torpedo-devkit", omap3_logicpd_torpedo_init, },
 	{ "ti,omap3-evm-37xx", omap3_evm_legacy_init, },
 	{ "ti,am3517-evm", am3517_evm_legacy_init, },
-- 
2.56.0

