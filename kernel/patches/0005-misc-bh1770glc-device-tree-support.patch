From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 18:31:24 +0100
Subject: [PATCH] misc: bh1770glc: device tree support

The driver required platform data, which no device tree board has, so
the sensor of the Nokia N950 and N9 had no driver. Without platform
data, read the two values it carries from the device tree: the
proximity LED's current (rohm,proximity-led-microamp) and the glass
attenuation (rohm,glass-attenuation), and match the compatibles
rohm,bh1770glc and osram,sfh7770. With a binding.

Untested on hardware.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/iio/light/rohm,bh1770glc.yaml    | 71 +++++++++++++++++++
 drivers/misc/bh1770glc.c                      | 56 +++++++++++++--
 2 files changed, 123 insertions(+), 4 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/iio/light/rohm,bh1770glc.yaml

diff --git a/Documentation/devicetree/bindings/iio/light/rohm,bh1770glc.yaml b/Documentation/devicetree/bindings/iio/light/rohm,bh1770glc.yaml
new file mode 100644
index 000000000..bf3a893ec
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/light/rohm,bh1770glc.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/light/rohm,bh1770glc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ROHM BH1770GLC / Osram SFH7770 ambient light and proximity sensor
+
+maintainers:
+  - Sebastian Matkovich <sebastian.matkovich@gmail.com>
+
+description:
+  Combined ambient light and proximity sensor with an infrared LED driver
+  for the proximity measurement, as in the Nokia N950 and N9.
+
+properties:
+  compatible:
+    enum:
+      - rohm,bh1770glc
+      - osram,sfh7770
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  Vcc-supply: true
+
+  Vleds-supply:
+    description: Supply of the proximity LED
+
+  rohm,proximity-led-microamp:
+    description: Current of the proximity LED.
+    enum: [5000, 10000, 20000, 50000, 100000, 150000, 200000]
+    default: 50000
+
+  rohm,glass-attenuation:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      How much the cover glass attenuates the light, scaled by 16384
+      (16384 means no attenuation).
+    default: 16384
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - Vcc-supply
+  - Vleds-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        proximity@38 {
+            compatible = "rohm,bh1770glc";
+            reg = <0x38>;
+            interrupt-parent = <&gpio3>;
+            interrupts = <19 IRQ_TYPE_EDGE_FALLING>;
+            Vcc-supply = <&vaux1>;
+            Vleds-supply = <&vbat>;
+            rohm,proximity-led-microamp = <50000>;
+            rohm,glass-attenuation = <63078>;
+        };
+    };
diff --git a/drivers/misc/bh1770glc.c b/drivers/misc/bh1770glc.c
index 0c052b05a..46142f3f0 100644
--- a/drivers/misc/bh1770glc.c
+++ b/drivers/misc/bh1770glc.c
@@ -14,6 +14,7 @@
 #include <linux/interrupt.h>
 #include <linux/mutex.h>
 #include <linux/platform_data/bh1770glc.h>
+#include <linux/property.h>
 #include <linux/regulator/consumer.h>
 #include <linux/pm_runtime.h>
 #include <linux/workqueue.h>
@@ -1162,6 +1163,44 @@ static const struct attribute_group bh1770_attribute_group = {
 	.attrs = sysfs_attrs
 };
 
+/*
+ * Without platform data, its two values from the device tree: the proximity
+ * LED's current and the glass attenuation (16384 = 1.0)
+ */
+static struct bh1770_platform_data *bh1770_pdata_from_fw(struct device *dev)
+{
+	static const u32 led_ua[] = {
+		[BH1770_LED_5mA] = 5000,
+		[BH1770_LED_10mA] = 10000,
+		[BH1770_LED_20mA] = 20000,
+		[BH1770_LED_50mA] = 50000,
+		[BH1770_LED_100mA] = 100000,
+		[BH1770_LED_150mA] = 150000,
+		[BH1770_LED_200mA] = 200000,
+	};
+	struct bh1770_platform_data *pdata;
+	u32 ua = 50000;
+	int i;
+
+	pdata = devm_kzalloc(dev, sizeof(*pdata), GFP_KERNEL);
+	if (!pdata)
+		return ERR_PTR(-ENOMEM);
+
+	device_property_read_u32(dev, "rohm,glass-attenuation",
+				 &pdata->glass_attenuation);
+	device_property_read_u32(dev, "rohm,proximity-led-microamp", &ua);
+	for (i = 0; i < ARRAY_SIZE(led_ua); i++)
+		if (led_ua[i] == ua)
+			break;
+	if (i == ARRAY_SIZE(led_ua)) {
+		dev_err(dev, "unsupported proximity LED current %u uA\n", ua);
+		return ERR_PTR(-EINVAL);
+	}
+	pdata->led_def_curr = i;
+
+	return pdata;
+}
+
 static int bh1770_probe(struct i2c_client *client)
 {
 	struct bh1770_chip *chip;
@@ -1178,12 +1217,13 @@ static int bh1770_probe(struct i2c_client *client)
 	init_waitqueue_head(&chip->wait);
 	INIT_DELAYED_WORK(&chip->prox_work, bh1770_prox_work);
 
-	if (client->dev.platform_data == NULL) {
-		dev_err(&client->dev, "platform data is mandatory\n");
-		return -EINVAL;
+	chip->pdata		= client->dev.platform_data;
+	if (chip->pdata == NULL) {
+		chip->pdata = bh1770_pdata_from_fw(&client->dev);
+		if (IS_ERR(chip->pdata))
+			return PTR_ERR(chip->pdata);
 	}
 
-	chip->pdata		= client->dev.platform_data;
 	chip->lux_calib		= BH1770_LUX_NEUTRAL_CALIB_VALUE;
 	chip->lux_rate_index	= BH1770_LUX_DEFAULT_RATE;
 	chip->lux_threshold_lo	= BH1770_LUX_DEF_THRES;
@@ -1368,6 +1408,13 @@ static const struct i2c_device_id bh1770_id[] = {
 
 MODULE_DEVICE_TABLE(i2c, bh1770_id);
 
+static const struct of_device_id bh1770_of_match[] = {
+	{ .compatible = "rohm,bh1770glc" },
+	{ .compatible = "osram,sfh7770" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, bh1770_of_match);
+
 static const struct dev_pm_ops bh1770_pm_ops = {
 	SET_SYSTEM_SLEEP_PM_OPS(bh1770_suspend, bh1770_resume)
 	SET_RUNTIME_PM_OPS(bh1770_runtime_suspend, bh1770_runtime_resume, NULL)
@@ -1376,6 +1423,7 @@ static const struct dev_pm_ops bh1770_pm_ops = {
 static struct i2c_driver bh1770_driver = {
 	.driver	  = {
 		.name	= "bh1770glc",
+		.of_match_table = bh1770_of_match,
 		.pm	= &bh1770_pm_ops,
 	},
 	.probe    = bh1770_probe,
-- 
2.56.0

