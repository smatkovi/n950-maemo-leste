From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 17:58:52 +0100
Subject: [PATCH] drm/panel: dsi-cm: panel orientation from the device tree

Read the panel's mounting orientation from the device tree's
"orientation" property and report it to DRM, which sets the connector's
panel orientation property from it (for fbcon and display servers), as
other panel drivers do. The Nokia N950's panel is mounted for portrait
use while the phone is used in landscape with its keyboard.

Untested on hardware.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-dsi-cm.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-dsi-cm.c b/drivers/gpu/drm/panel/panel-dsi-cm.c
index cb89dfe6d..481d46030 100644
--- a/drivers/gpu/drm/panel/panel-dsi-cm.c
+++ b/drivers/gpu/drm/panel/panel-dsi-cm.c
@@ -68,6 +68,8 @@ struct panel_drv_data {
 
 	bool use_dsi_backlight;
 
+	enum drm_panel_orientation orientation;
+
 	/* runtime variables */
 	bool enabled;
 
@@ -790,12 +792,20 @@ static int dsicm_get_modes(struct drm_panel *panel,
 	return 1;
 }
 
+static enum drm_panel_orientation dsicm_get_orientation(struct drm_panel *panel)
+{
+	struct panel_drv_data *ddata = panel_to_ddata(panel);
+
+	return ddata->orientation;
+}
+
 static const struct drm_panel_funcs dsicm_panel_funcs = {
 	.unprepare = dsicm_unprepare,
 	.disable = dsicm_disable,
 	.prepare = dsicm_prepare,
 	.enable = dsicm_enable,
 	.get_modes = dsicm_get_modes,
+	.get_orientation = dsicm_get_orientation,
 };
 
 static int dsicm_probe_of(struct mipi_dsi_device *dsi)
@@ -830,6 +840,10 @@ static int dsicm_probe_of(struct mipi_dsi_device *dsi)
 	if (err)
 		return err;
 
+	err = of_drm_get_panel_orientation(dsi->dev.of_node, &ddata->orientation);
+	if (err)
+		return dev_err_probe(&dsi->dev, err, "invalid orientation\n");
+
 	backlight = devm_of_find_backlight(&dsi->dev);
 	if (IS_ERR(backlight))
 		return PTR_ERR(backlight);
-- 
