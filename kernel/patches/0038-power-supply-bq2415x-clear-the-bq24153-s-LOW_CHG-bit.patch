From 5662cef679d1f0f139f209962532552777213a9c Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 10 Nov 2026 09:47:42 +0100
Subject: [PATCH 38/38] power: supply: bq2415x: clear the bq24153's LOW_CHG bit

The bq24153(a) comes out of reset with LOW_CHG (bit 5 of register 5) set,
which caps the charge current at 22.1 mV across the sense resistor - 325
mA with the N950's 68 mOhm - whatever VI_CHRG says. Harmattan's bme
clears it on every plug-in (seen in a ptrace of bme on an N9); on the
N950 clearing it took the net battery current from +8 to +406 mA.

Clear it with the other defaults, and again on every timer tick since the
chip's own timeouts reset it, but only when the board gave the sense
resistor (otherwise VI_CHRG is not set either).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/bq2415x_charger.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/drivers/power/supply/bq2415x_charger.c b/drivers/power/supply/bq2415x_charger.c
index 1ba351c88..ab205b279 100644
--- a/drivers/power/supply/bq2415x_charger.c
+++ b/drivers/power/supply/bq2415x_charger.c
@@ -39,6 +39,7 @@
 #define BQ2415X_REG_VOLTAGE		0x02
 #define BQ2415X_REG_VENDER		0x03
 #define BQ2415X_REG_CURRENT		0x04
+#define BQ2415X_REG_SPECIAL		0x05	/* bq24153(a): special charger voltage */
 
 /* reset state for all registers */
 #define BQ2415X_RESET_STATUS		BIT(6)
@@ -88,6 +89,9 @@
 #define BQ2415X_MASK_VI_TERM		(BIT(0)|BIT(1)|BIT(2))
 #define BQ2415X_SHIFT_VI_TERM		0
 
+/* special charger voltage register (bq24153(a)) */
+#define BQ2415X_BIT_LOW_CHG		5	/* charge current capped at 22.1 mV / Rsense */
+
 
 enum bq2415x_command {
 	BQ2415X_TIMER_RESET,
@@ -726,6 +730,21 @@ static int bq2415x_get_termination_current(struct bq2415x_device *bq)
 			return ret; \
 	} while (0)
 
+/*
+ * The bq24153(a) comes up with LOW_CHG set, which caps the charge current at
+ * 22.1 mV across the sense resistor (325 mA with 68 mOhm) whatever VI_CHRG
+ * says; Harmattan's bme clears it on every plug-in. Clear it too when the
+ * board told us the sense resistor, i.e. when VI_CHRG means something.
+ */
+static void bq2415x_clear_low_charge(struct bq2415x_device *bq)
+{
+	if (bq->init_data.resistor_sense <= 0)
+		return;
+	if (bq->chip != BQ24153 && bq->chip != BQ24153A)
+		return;
+	bq2415x_i2c_write_bit(bq, BQ2415X_REG_SPECIAL, 0, BQ2415X_BIT_LOW_CHG);
+}
+
 /* set default values of all properties */
 static int bq2415x_set_defaults(struct bq2415x_device *bq)
 {
@@ -742,6 +761,7 @@ static int bq2415x_set_defaults(struct bq2415x_device *bq)
 		bq2415x_set_default_value(bq, termination_current);
 		bq2415x_exec_command(bq, BQ2415X_CHARGE_TERMINATION_ENABLE);
 	}
+	bq2415x_clear_low_charge(bq);
 
 	bq2415x_exec_command(bq, BQ2415X_CHARGER_ENABLE);
 	return 0;
@@ -954,6 +974,8 @@ static void bq2415x_timer_work(struct work_struct *work)
 	if (bq->init_data.battery_regulation_voltage)
 		bq2415x_set_battery_regulation_voltage(bq,
 				bq->init_data.battery_regulation_voltage);
+	/* the same timeouts bring LOW_CHG back */
+	bq2415x_clear_low_charge(bq);
 
 	boost = bq2415x_exec_command(bq, BQ2415X_BOOST_MODE_STATUS);
 	if (boost < 0) {
-- 
