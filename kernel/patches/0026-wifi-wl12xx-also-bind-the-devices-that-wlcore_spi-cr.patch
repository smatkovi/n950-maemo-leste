From 5d717770ead641c78e0474be4992d1f7ee3566db Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Tue, 3 Nov 2026 01:40:29 +0100
Subject: [PATCH] wifi: wl12xx: also bind the devices that wlcore_spi creates

wlcore_spi names the platform device for the chip after its family
("wl127x", "wl128x"), while wlcore_sdio names it "wl12xx", the only
name in wl12xx's ID table. On a wl127x/wl128x connected over SPI, like
the Nokia N950's WL1271, wl12xx therefore never probed and there was no
wlan interface.

Add the two family names to the ID table.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/ti/wl12xx/main.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/net/wireless/ti/wl12xx/main.c b/drivers/net/wireless/ti/wl12xx/main.c
index ffbf54776..345b7679e 100644
--- a/drivers/net/wireless/ti/wl12xx/main.c
+++ b/drivers/net/wireless/ti/wl12xx/main.c
@@ -1933,6 +1933,9 @@ static void wl12xx_remove(struct platform_device *pdev)
 
 static const struct platform_device_id wl12xx_id_table[] = {
 	{ "wl12xx", 0 },
+	/* wlcore_spi names the chip's device after its family */
+	{ "wl127x", 0 },
+	{ "wl128x", 0 },
 	{  } /* Terminating Entry */
 };
 MODULE_DEVICE_TABLE(platform, wl12xx_id_table);
-- 
