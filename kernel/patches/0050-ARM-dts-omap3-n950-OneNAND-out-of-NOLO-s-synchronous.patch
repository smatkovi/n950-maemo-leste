From 30260b78b19339942ae06a0ea1506b887bb86469 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 13:57:16 +0100
Subject: [PATCH 50/52] ARM: dts: omap3-n950: OneNAND out of NOLO's synchronous
 mode, var writable

Give the OneNAND node NOLO's CS0 configuration, so the driver can leave
the synchronous mode NOLO leaves the chip in, and make var writable for
flash swap through mtdswap, as Harmattan uses it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/ti/omap/omap3-n950.dts | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index f1f0248cd..7a905875d 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -459,13 +459,19 @@ fuel-gauge@55 {
  * OneNAND belongs to Harmattan: the boot loader (NOLO) and the calibration
  * data (config) stay read-only so they can never be touched. The kernel
  * partition is left writable on purpose, so an alternative boot loader
- * (ubiboot) can be flashed into it from Leste.
+ * (ubiboot) can be flashed into it from Leste, and var, for swap through
+ * mtdswap as under Harmattan.
  *
  * The inherited sync/burst GPMC timings fail to detect the chip on v6.x
  * ("OneNAND Manufacturer: Unknown (0xa0)"). Drop them so onenand_scan()
- * identifies the chip in async mode (its power-on default); the driver's
- * post-scan sync optimisation is disabled for this reason in
+ * identifies the chip in async mode; the driver's post-scan sync
+ * optimisation is disabled for this reason in
  * drivers/mtd/nand/onenand/onenand_omap2.c, so it keeps running async.
+ *
+ * NOLO leaves the chip in synchronous read and write mode, and the GPMC is
+ * reset before the driver runs, so writes do not reach the chip and its
+ * identification fails ("Unknown (0xab6c)"). The driver clears that mode
+ * under NOLO's own CS0 configuration, given here.
  */
 &gpmc {
 	onenand@0,0 {
@@ -477,6 +483,9 @@ onenand@0,0 {
 		/delete-property/ gpmc,burst-length;
 		/delete-property/ gpmc,sync-clk-ps;
 
+		nokia,boot-gpmc-config = <0xfd001202 0x00181800 0x00030300
+					  0x18001804 0x03171d1d 0x97080000>;
+
 		partition@0 {
 			read-only;
 		};
@@ -486,9 +495,6 @@ partition@1 {
 		partition@3 {
 			read-only;
 		};
-		partition@4 {
-			read-only;
-		};
 		partition@5 {
 			read-only;
 		};
