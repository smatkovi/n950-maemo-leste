From 3e6f5d724dd1784313fd52962bb1f5ad25cb049e Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 9 Nov 2026 13:24:26 +0100
Subject: [PATCH] ARM: dts: omap3-n950: overclock turbo OPPs 1.1/1.2/1.3 GHz at
 1.400/1.425/1.450 V

At the owner's request. Not in TI's tables; the TWL4030's VDD1 ends at 1.450 V.
Forward body bias as for OPP1G. User space caps scaling_max_freq to the step
that passed a stability test (rootfs n950-boost, /etc/n950-maxfreq).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/arm/boot/dts/ti/omap/omap3-n950.dts | 47 ++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm/boot/dts/ti/omap/omap3-n950.dts b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
index cf08defb7..19fdd13dd 100644
--- a/arch/arm/boot/dts/ti/omap/omap3-n950.dts
+++ b/arch/arm/boot/dts/ti/omap/omap3-n950.dts
@@ -170,6 +170,53 @@ &cpu0_opp_table {
 	opp-1000000000 {
 		opp-supported-hw = <0xffffffff 3>;
 	};
+
+	/*
+	 * Overclocking, at the owner's request (2026-11-09). These are not in
+	 * TI's tables: 1.1 GHz at 1.400 V, 1.2 GHz at 1.425 V, 1.3 GHz at 1.450 V
+	 * (the TWL4030's VDD1 maximum). All turbo OPPs; user space caps
+	 * scaling_max_freq (/etc/n950-maxfreq) to the step that passed its
+	 * stability test. The cpu thermal zone throttles at 80 C.
+	 */
+	opp-1100000000 {
+		opp-hz = /bits/ 64 <1100000000>;
+		opp-microvolt = <1400000 1400000 1400000>,
+				 <1400000 1400000 1400000>;
+		opp-supported-hw = <0xffffffff 3>;
+		turbo-mode;
+	};
+	opp-1200000000 {
+		opp-hz = /bits/ 64 <1200000000>;
+		opp-microvolt = <1425000 1425000 1425000>,
+				 <1425000 1425000 1425000>;
+		opp-supported-hw = <0xffffffff 3>;
+		turbo-mode;
+	};
+	opp-1300000000 {
+		opp-hz = /bits/ 64 <1300000000>;
+		opp-microvolt = <1450000 1450000 1450000>,
+				 <1450000 1450000 1450000>;
+		opp-supported-hw = <0xffffffff 3>;
+		turbo-mode;
+	};
+};
+
+&opp_supply_mpu_iva {
+	ti,absolute-max-voltage-uv = <1450000>;
+};
+
+/* body bias: forward bias (as for OPP1G) at the overclock voltages too */
+&abb_mpu_iva {
+	ti,abb_info = <
+	/*uV		ABB	efuse	rbb_m	fbb_m	vset_m*/
+	1012500		0	0	0	0	0
+	1200000		0	0	0	0	0
+	1325000		0	0	0	0	0
+	1375000		1	0	0	0	0
+	1400000		1	0	0	0	0
+	1425000		1	0	0	0	0
+	1450000		1	0	0	0	0
+	>;
 };
 
 &twl {
-- 
