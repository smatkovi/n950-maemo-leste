#!/bin/sh
# n950-fm-audio -- the N950's FM sound on or off.
#
#   n950-fm-audio on | off | status
#
# The WL1273 sends the radio's sound over I2S to McBSP4, the sound card
# "N950 FM" (kernel patches 0043-0045), as FM radio apps under Harmattan
# record it; the analog route to the TWL5031's AUX inputs carries silence.
# The chip drives the I2S port only after a Bluetooth vendor command, which
# n950-fm-bt sends (it switches Bluetooth on if it is off). "on" then plays
# the card's capture on PulseAudio's default sink (speaker or headphones)
# through a loopback stream "fm_loopback"; "off" ends it. FM_LATENCY
# (milliseconds, /etc/default/n950-fm) sets the loopback's latency. Run as
# the session's user. Prints the loopback's module number on "on".
set -u
PATH=$PATH:/usr/sbin:/sbin

CARD_NAME="N950 FM"
BT_HELPER=${N950_FM_BT:-/usr/libexec/n950-fm-bt}
FM_LATENCY=100
[ -r /etc/default/n950-fm ] && . /etc/default/n950-fm
STATE=${XDG_RUNTIME_DIR:-/tmp}/n950-fm-audio-$(id -u)

say() { echo "n950-fm-audio: $*" >&2; }

# PulseAudio's capture source of the card "N950 FM"
pa_source() {
	pactl list sources 2>/dev/null | awk -v want="$CARD_NAME" '
		/^Source #/ { name = "" }
		/^\tName: / { name = $2 }
		/^\t\talsa\.card_name = / {
			v = $0; sub(/^[^"]*"/, "", v); sub(/".*/, "", v)
			if (v == want && name != "") { print name; exit }
		}'
}

on() {
	if [ -e "$STATE/module" ]; then
		say "already on"
		cat "$STATE/module"
		return 0
	fi
	"$BT_HELPER" || { say "the FM audio route over Bluetooth failed"; return 1; }
	src=
	for _ in 1 2 3 4 5; do	# PipeWire may still be setting the card up
		src=$(pa_source)
		[ -n "$src" ] && break
		sleep 1
	done
	if [ -z "$src" ]; then
		say "PulseAudio has no capture source of the card \"$CARD_NAME\""
		return 1
	fi
	mkdir -p "$STATE" || return 1
	mod=$(pactl load-module module-loopback source="$src" \
		latency_msec="$FM_LATENCY" source_dont_move=true \
		sink_input_properties=media.name=fm_loopback) ||
		{ say "the loopback from $src does not start"; rm -rf "$STATE"; return 1; }
	echo "$mod" > "$STATE/module"
	echo "$mod"
}

off() {
	mod=$(cat "$STATE/module" 2>/dev/null)
	[ -n "$mod" ] && pactl unload-module "$mod" 2>/dev/null
	rm -rf "$STATE"
	return 0
}

case ${1:-} in
on) on ;;
off) off ;;
status)
	if [ -e "$STATE/module" ]; then
		echo "on (loopback module $(cat "$STATE/module"))"
	else
		echo off
	fi
	;;
*)
	echo "usage: n950-fm-audio on|off|status" >&2
	exit 2
	;;
esac
